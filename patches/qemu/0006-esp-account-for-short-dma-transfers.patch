Subject: [PATCH 6/17] esp: account for short DMA transfers

Let the SCSI core consume only bytes reported by its DMA callback.
Keep legacy adapter behavior and retain deferred work across START.

---
--- a/include/hw/mips/mips.h
+++ b/include/hw/mips/mips.h
@@ -14,8 +14,8 @@
 
 /* rc4030.c */
 typedef struct rc4030DMAState *rc4030_dma;
-void rc4030_dma_read(void *dma, uint8_t *buf, int len);
-void rc4030_dma_write(void *dma, uint8_t *buf, int len);
+int rc4030_dma_read(void *dma, uint8_t *buf, int len);
+int rc4030_dma_write(void *dma, uint8_t *buf, int len);
 
 DeviceState *rc4030_init(rc4030_dma **dmas, IOMMUMemoryRegion **dma_mr);
 
