index 0000000..e531b2d
--- /dev/null
+++ b/tests/qtest/tcx-test.c
@@ -0,0 +1,78 @@
+/*
+ * TCX overlapping blit regression tests.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+
+#define TCX 0x50000000ULL
+#define DFB8 (TCX + 0x00800000)
+#define DFB24 (TCX + 0x02000000)
+#define RDFB32 (TCX + 0x0a000000)
+#define BLIT (TCX + 0x06000000)
+#define RBLIT (TCX + 0x0e000000)
+
+static void overlap(const void *opaque)
+{
+    unsigned mode = GPOINTER_TO_UINT(opaque);
+    bool raw = mode & 1, depth24 = mode & 2;
+    QTestState *q = qtest_initf(
+        "-machine SS-5 -m 64 -g 1024x768x%u -display none", depth24 ? 24 : 8);
+    uint8_t pixels[128], expected[128], actual[128];
+    uint32_t rgb[128], ctl[128], rgb_expected[128], ctl_expected[128];
+    unsigned len, src, dst, i;
+    int delta;
+
+    for (len = 1; len <= 32; len++) {
+        for (delta = -31; delta <= 31; delta++) {
+            src = 48;
+            dst = src + delta;
+            for (i = 0; i < 128; i++) {
+                pixels[i] = i * 37;
+                rgb[i] = GUINT32_TO_BE(0x123400 + i);
+                ctl[i] = GUINT32_TO_BE((i & 3) << 24);
+            }
+            memcpy(expected, pixels, sizeof(pixels));
+            memcpy(rgb_expected, rgb, sizeof(rgb));
+            memcpy(ctl_expected, ctl, sizeof(ctl));
+            memmove(expected + dst, expected + src, len);
+            memmove(rgb_expected + dst, rgb_expected + src, len * 4);
+            if (raw) {
+                memmove(ctl_expected + dst, ctl_expected + src, len * 4);
+            }
+            qtest_memwrite(q, DFB8, pixels, sizeof(pixels));
+            if (depth24) {
+                qtest_memwrite(q, DFB24, rgb, sizeof(rgb));
+                qtest_memwrite(q, RDFB32, ctl, sizeof(ctl));
+            }
+            qtest_writel(q, (raw ? RBLIT : BLIT) + dst * 8, 0x30000000);
+            qtest_writel(q, (raw ? RBLIT : BLIT) + dst * 8 + 4,
+                         ((len - 1) << 24) | src);
+            qtest_memread(q, DFB8, actual, sizeof(actual));
+            g_assert_cmpmem(actual, sizeof(actual), expected, sizeof(expected));
+            if (!depth24) {
+                continue;
+            }
+            qtest_memread(q, DFB24, rgb, sizeof(rgb));
+            g_assert_cmpmem(rgb, sizeof(rgb),
+                            rgb_expected, sizeof(rgb_expected));
+            qtest_memread(q, RDFB32, ctl, sizeof(ctl));
+            g_assert_cmpmem(ctl, sizeof(ctl),
+                            ctl_expected, sizeof(ctl_expected));
+        }
+    }
+    qtest_quit(q);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_data_func("/tcx/8bit/blit-overlap", GUINT_TO_POINTER(0), overlap);
+    qtest_add_data_func("/tcx/8bit/raw-blit-overlap",
+                        GUINT_TO_POINTER(1), overlap);
+    qtest_add_data_func("/tcx/24bit/blit-overlap",
+                        GUINT_TO_POINTER(2), overlap);
+    qtest_add_data_func("/tcx/24bit/raw-blit-overlap",
+                        GUINT_TO_POINTER(3), overlap);
+    return g_test_run();
+}
