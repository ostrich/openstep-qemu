+static void flat_page_error(void)
+{
+    QTestState *q = start();
+
+    select_data(q, false, 1024);
+    begin_dma(q, false, false, 1024, 0xfffe00, 0);
+    reg_write(q, 3, 0x90);
+    for (unsigned i = 0; i < 100; i++) {
+        qtest_clock_step(q, 1000000);
+    }
+    g_assert_cmphex(dma_read(q, 5) & (ERROR | ABORT | DONE), ==, ERROR | ABORT);
+    g_assert_cmphex(dma_read(q, 3), ==, 512);
+    g_assert_cmphex(dma_read(q, 4), ==, 0x1000000);
+    check_bytes(q, 0xfffe00, fixture, 512);
+    begin_dma(q, false, false, 512, FLAT, 0);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, FLAT, fixture + 512, 512);
+    qtest_quit(q);
+}
