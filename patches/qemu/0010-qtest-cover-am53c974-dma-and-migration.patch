+int main(int argc, char **argv)
+{
+    int fd, i;
+    g_test_init(&argc, &argv, NULL);
+    for (i = 0; i < sizeof(fixture); i++) {
+        fixture[i] = i * 37 + (i >> 8) * 13 + 11;
+    }
+    fd = g_file_open_tmp("am53c974-test-XXXXXX", &disk_path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(write(fd, fixture, sizeof(fixture)), ==, sizeof(fixture));
+    close(fd);
+    for (i = 0; i < 2; i++) {
+        unsigned direction = i << 24;
+        g_autofree char *name =
+            g_strdup_printf("/am53c974/%s", i ? "write" : "read");
+        g_autofree char *flat = g_strconcat(name, "/flat", NULL);
+        g_autofree char *single = g_strconcat(name, "/single-page", NULL);
+        g_autofree char *boundary = g_strconcat(name, "/exact-boundary", NULL);
+        g_autofree char *multiple = g_strconcat(name, "/noncontiguous", NULL);
+        g_autofree char *restart_name = g_strconcat(name, "/restart", NULL);
+        qtest_add_data_func(
+            flat, GUINT_TO_POINTER(direction | (1U << 25) | (10 << 12)),
+            transfer);
+        qtest_add_data_func(
+            single, GUINT_TO_POINTER(direction | (1 << 12) | 17), transfer);
+        qtest_add_data_func(
+            boundary, GUINT_TO_POINTER(direction | (1 << 12) | 3584), transfer);
+        qtest_add_data_func(multiple,
+                            GUINT_TO_POINTER(direction | (10 << 12) | 4090),
+                            transfer);
+        qtest_add_data_func(restart_name, GUINT_TO_POINTER(i), restart);
+    }
+    qtest_add_func("/am53c974/registers", registers);
+    qtest_add_func("/am53c974/descriptor-error", descriptor_error);
+    qtest_add_data_func("/am53c974/read/data-error", GUINT_TO_POINTER(0),
+                        access_error);
+    qtest_add_data_func("/am53c974/write/data-error", GUINT_TO_POINTER(1),
+                        access_error);
+    qtest_add_data_func("/am53c974/read/next-descriptor-error",
+                        GUINT_TO_POINTER(2), access_error);
+    qtest_add_data_func("/am53c974/write/next-descriptor-error",
+                        GUINT_TO_POINTER(3), access_error);
+    qtest_add_func("/am53c974/interrupts", interrupts);
+    qtest_add_func("/am53c974/command-restart", command_restart);
+    qtest_add_data_func("/am53c974/read/scsi-segment", GUINT_TO_POINTER(0),
+                        scsi_segment);
+    qtest_add_data_func("/am53c974/write/scsi-segment", GUINT_TO_POINTER(1),
+                        scsi_segment);
+    qtest_add_data_func("/am53c974/short-response/1", GUINT_TO_POINTER(1),
+                        short_response);
+    qtest_add_data_func("/am53c974/short-response/3", GUINT_TO_POINTER(3),
+                        short_response);
+    qtest_add_data_func("/am53c974/short-response/17", GUINT_TO_POINTER(17),
+                        short_response);
+    qtest_add_func("/am53c974/pending-scsi-interrupt", pending_scsi_interrupt);
+    qtest_add_func("/am53c974/idle-restart", idle_restart);
+    qtest_add_data_func("/am53c974/read/reset-pending", GUINT_TO_POINTER(0),
+                        reset_pending);
+    qtest_add_data_func("/am53c974/write/reset-pending", GUINT_TO_POINTER(1),
+                        reset_pending);
+    qtest_add_func("/am53c974/page-interrupt", page_interrupt);
+    qtest_add_data_func("/am53c974/migration/ready", GUINT_TO_POINTER(0),
+                        migration_ready);
+    qtest_add_data_func("/am53c974/migration/partial-read", GUINT_TO_POINTER(1),
+                        migration_ready);
+    qtest_add_data_func("/am53c974/migration/partial-write",
+                        GUINT_TO_POINTER(2), migration_ready);
+    qtest_add_data_func("/am53c974/migration/page-interrupt",
+                        GUINT_TO_POINTER(3), migration_ready);
+    qtest_add_func("/am53c974/flat-page-error", flat_page_error);
+    qtest_add_data_func("/am53c974/migration/invalid-enable",
+                        GUINT_TO_POINTER(4), migration_ready);
+    qtest_add_data_func("/am53c974/migration/invalid-continuation",
+                        GUINT_TO_POINTER(5), migration_ready);
+    qtest_add_data_func("/am53c974/migration/invalid-buffer-offset",
+                        GUINT_TO_POINTER(6), migration_ready);
+    qtest_add_data_func("/am53c974/migration/invalid-buffer-length",
+                        GUINT_TO_POINTER(7), migration_ready);
+    qtest_add_data_func("/am53c974/migration/command", GUINT_TO_POINTER(8),
+                        migration_ready);
+    i = g_test_run();
+    unlink(disk_path);
+    g_free(disk_path);
+    return i;
+}
