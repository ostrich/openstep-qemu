Subject: [PATCH 10/16] qtest: cover Am53C974 DMA, lifecycle, interrupts and migration

Add sector-distinct data/guard checks for flat and MDL transfers,
channel lifecycle, errors, BLAST, migration and invalid state.
Keep the existing AMD crash-regression suite unchanged.

---
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2346,6 +2346,7 @@
 F: tests/qtest/virtio-scsi-test.c
 F: tests/qtest/fuzz-virtio-scsi-test.c
 F: tests/qtest/am53c974-test.c
+F: tests/qtest/am53c974-dma-test.c
 F: tests/qtest/fuzz-lsi53c895a-test.c
 F: tests/functional/x86_64/test_hotplug_scsi.py
 T: git https://github.com/bonzini/qemu.git scsi-next
--- /dev/null
+++ b/tests/qtest/am53c974-dma-test.c
@@ -0,0 +1,873 @@
+/*
+ * AMD Am53C974 DMA regression tests.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register expectations follow AMD's 1993 Am53C974 datasheet, chapter 6.
+ */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define IO 0x1000
+#define TABLE 0x10000
+#define FLAT 0x300000
+#define GUARD 0xa5
+#define DONE 8
+#define ABORT 4
+#define ERROR 2
+#define BLAST_COMPLETE 0x20
+
+static const uint32_t pages[] = {0x100000, 0x180000, 0x240000};
+static uint8_t fixture[16384];
+static char *disk_path;
+
+static void reg_write(QTestState *q, unsigned reg, uint8_t value)
+{
+    qtest_outb(q, IO + reg * 4, value);
+}
+
+static uint8_t reg_read(QTestState *q, unsigned reg)
+{
+    return qtest_inb(q, IO + reg * 4);
+}
+
+static void dma_write(QTestState *q, unsigned reg, uint32_t value)
+{
+    qtest_outl(q, IO + 0x40 + reg * 4, value);
+}
+
+static uint32_t dma_read(QTestState *q, unsigned reg)
+{
+    return qtest_inl(q, IO + 0x40 + reg * 4);
+}
+
+static uint8_t finish_command(QTestState *q)
+{
+    uint8_t status;
+
+    reg_read(q, 5);
+    reg_write(q, 3, 0x11); /* Initiator command complete, PIO status/message. */
+    reg_read(q, 5);
+    status = reg_read(q, 2);
+    g_assert_cmphex(reg_read(q, 2), ==, 0);
+    reg_write(q, 3, 0x12); /* Message accepted. */
+    reg_read(q, 5);
+    return status;
+}
+
+static void configure_pci(QTestState *q)
+{
+    qtest_outl(q, 0xcf8, 0x80002010);
+    qtest_outl(q, 0xcfc, IO | 1);
+    qtest_outl(q, 0xcf8, 0x80002004);
+    qtest_outl(q, 0xcfc, 5); /* I/O and bus mastering. */
+}
+
+static QTestState *start(void)
+{
+    QTestState *q = qtest_initf(
+        "-machine pc -nodefaults -m 16 -device am53c974,addr=04.0,id=scsi "
+        "-drive file=%s,format=raw,if=none,id=disk,cache=writeback "
+        "-device scsi-hd,drive=disk,bus=scsi.0,scsi-id=0",
+        disk_path);
+    unsigned i, j;
+
+    configure_pci(q);
+    for (i = 0; i < G_N_ELEMENTS(pages); i++) {
+        qtest_writel(q, TABLE + i * 4, pages[i] | 0x555);
+        qtest_memset(q, pages[i], GUARD, 4096);
+    }
+    /* Consume power-on UNIT ATTENTION; the second TUR must succeed. */
+    for (i = 0; i < 2; i++) {
+        reg_write(q, 3, 1);
+        reg_write(q, 4, 0);
+        reg_write(q, 2, 0x80);
+        for (j = 0; j < 6; j++) {
+            reg_write(q, 2, 0);
+        }
+        reg_write(q, 3, 0x42);
+        if (i == 1) {
+            g_assert_cmphex(finish_command(q), ==, 0);
+        } else {
+            g_assert_cmphex(finish_command(q), ==, 2);
+        }
+    }
+    return q;
+}
+
+static void select_data(QTestState *q, bool write, unsigned size)
+{
+    uint8_t cdb[] = {write ? 0x2a : 0x28, 0,          0, 0, 0, 0, 0,
+                     (size / 512) >> 8,   size / 512, 0};
+    unsigned i;
+
+    reg_write(q, 3, 1);
+    reg_write(q, 4, 0);
+    reg_write(q, 2, 0x80);
+    for (i = 0; i < sizeof(cdb); i++) {
+        reg_write(q, 2, cdb[i]);
+    }
+    reg_write(q, 3, 0x42);
+    reg_read(q, 5);
+    reg_write(q, 0, size);
+    reg_write(q, 1, size >> 8);
+    reg_write(q, 14, size >> 16);
+}
+
+static void begin_dma(QTestState *q, bool mdl, bool write, unsigned size,
+                      uint32_t address, uint32_t table)
+{
+    dma_write(q, 1, size);
+    dma_write(q, 2, address);
+    dma_write(q, 6, table);
+    dma_write(q, 0, 3 | (mdl ? 0x10 : 0) | (write ? 0 : 0x80));
+}
+
+static void wait_dma(QTestState *q)
+{
+    int64_t deadline = g_get_monotonic_time() + 5 * G_TIME_SPAN_SECOND;
+
+    while (dma_read(q, 3)) {
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        qtest_clock_step(q, 1000000);
+    }
+}
+
+static void check_bytes(QTestState *q, uint32_t addr, const uint8_t *data,
+                        unsigned size)
+{
+    g_autofree uint8_t *actual = g_malloc(size);
+
+    qtest_memread(q, addr, actual, size);
+    g_assert_cmpmem(actual, size, data, size);
+}
+
+/*
+ * Encoded case: bit 24 write, bit 25 flat, bits 12:23 size/512, low 12 offset.
+ */
+static void transfer(const void *opaque)
+{
+    unsigned test = GPOINTER_TO_UINT(opaque);
+    bool write = test & (1U << 24), mdl = !(test & (1U << 25));
+    unsigned size = ((test >> 12) & 0xfff) * 512;
+    unsigned offset = test & 0xfff, remaining = size, at = 0, i;
+    QTestState *q = start();
+    unsigned final_page = 0, final_offset = 0;
+    uint8_t guards[4096];
+
+    memset(guards, GUARD, sizeof(guards));
+    if (mdl) {
+        for (i = 0; remaining; i++) {
+            unsigned skip = i ? 0 : offset;
+            unsigned len = MIN(remaining, 4096 - skip);
+            if (write) {
+                qtest_memwrite(q, pages[i] + skip, fixture + at, len);
+            }
+            remaining -= len;
+            at += len;
+            final_page = i;
+            final_offset = skip + len;
+        }
+    } else {
+        qtest_memset(q, FLAT, GUARD, size);
+        if (write) {
+            qtest_memwrite(q, FLAT, fixture, size);
+        }
+    }
+    select_data(q, write, size);
+    begin_dma(q, mdl, write, size, mdl ? offset : FLAT, TABLE | 3);
+    g_assert_cmphex(dma_read(q, 4), ==, mdl ? pages[0] + offset : FLAT);
+    g_assert_cmphex(dma_read(q, 6), ==, TABLE);
+    reg_write(q, 3, 0x90);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    g_assert_cmphex(dma_read(q, 5) & DONE, ==, DONE);
+    g_assert_cmphex(dma_read(q, 5) & DONE, ==, 0); /* Read-to-clear. */
+    if (mdl) {
+        g_assert_cmphex(dma_read(q, 7), ==, TABLE + final_page * 4);
+        g_assert_cmphex(dma_read(q, 4), ==, pages[final_page] + final_offset);
+        g_assert_cmphex(dma_read(q, 2), ==, pages[final_page] | offset);
+        check_bytes(q, pages[0], guards, offset);
+        if (final_offset < 4096) {
+            check_bytes(q, pages[final_page] + final_offset, guards,
+                        4096 - final_offset);
+        }
+        remaining = size;
+        at = 0;
+        for (i = 0; remaining; i++) {
+            unsigned skip = i ? 0 : offset;
+            unsigned len = MIN(remaining, 4096 - skip);
+            check_bytes(q, pages[i] + skip, fixture + at, len);
+            remaining -= len;
+            at += len;
+        }
+    } else {
+        g_assert_cmphex(dma_read(q, 4), ==, FLAT + size);
+        g_assert_cmphex(dma_read(q, 2), ==, FLAT);
+        check_bytes(q, FLAT, fixture, size);
+    }
+    /* A write test is followed by a read to a different buffer. */
+    if (write) {
+        select_data(q, false, size);
+        begin_dma(q, false, false, size, FLAT + 0x10000, 0);
+        reg_write(q, 3, 0x90);
+        wait_dma(q);
+        g_assert_cmphex(finish_command(q), ==, 0);
+        check_bytes(q, FLAT + 0x10000, fixture, size);
+    }
+    qtest_quit(q);
+}
+
+static void registers(void)
+{
+    QTestState *q = start();
+
+    dma_write(q, 1, 0xff123456);
+    g_assert_cmphex(dma_read(q, 1), ==, 0x123456);
+    dma_write(q, 6, TABLE | 3);
+    g_assert_cmphex(dma_read(q, 6), ==, TABLE);
+    /* Zero-byte START must not fetch from an unmapped MDL. */
+    begin_dma(q, true, false, 0, 0x123, 0xfef00000);
+    g_assert_cmphex(dma_read(q, 3), ==, 0);
+    g_assert_cmphex(dma_read(q, 5) & (DONE | ERROR | ABORT), ==, DONE);
+    begin_dma(q, true, false, 512, 0, TABLE);
+    dma_write(q, 0, 0x92); /* Abort leaves counters available to software. */
+    g_assert_cmphex(dma_read(q, 3), ==, 512);
+    g_assert_cmphex(dma_read(q, 5) & ABORT, ==, ABORT);
+    g_assert_cmphex(dma_read(q, 5) & ABORT, ==, 0);
+    /* BLAST's DMA FIFO is empty; it must not consume the SCSI FIFO. */
+    reg_write(q, 2, 0x5a);
+    dma_write(q, 0, 0x91);
+    g_assert_cmphex(dma_read(q, 5) & BLAST_COMPLETE, ==, BLAST_COMPLETE);
+    g_assert_cmphex(reg_read(q, 2), ==, 0x5a);
+    g_assert_cmphex(dma_read(q, 3), ==, 512);
+    qtest_qmp_assert_success(q, "{ 'execute': 'system_reset' }");
+    configure_pci(q);
+    g_assert_cmphex(dma_read(q, 0) & 0xff, ==, 0);
+    g_assert_cmphex(dma_read(q, 3), ==, 0);
+    g_assert_cmphex(dma_read(q, 4), ==, 0xffffffff);
+    g_assert_cmphex(dma_read(q, 7), ==, 0xfffffffc);
+    g_assert_cmphex(dma_read(q, 5) & 0x3e, ==, 0);
+    qtest_quit(q);
+}
+
+static void restart(const void *opaque)
+{
+    bool write = GPOINTER_TO_UINT(opaque);
+    QTestState *q = start();
+
+    qtest_memwrite(q, pages[0], fixture, 512);
+    qtest_memwrite(q, pages[1], fixture + 512, 512);
+    select_data(q, write, 1024);
+    begin_dma(q, true, write, 512, 0, TABLE);
+    reg_write(q, 3, 0x90);
+    wait_dma(q);
+    g_assert_cmphex(dma_read(q, 5) & DONE, ==, DONE);
+    g_assert_cmphex(reg_read(q, 0) | reg_read(q, 1) << 8, ==, 512);
+    dma_write(q, 0, 2 | 0x10 | (write ? 0 : 0x80));
+    g_assert_cmphex(dma_read(q, 5) & ABORT, ==, ABORT);
+    /* START resumes the outstanding transfer without reissuing the CDB. */
+    begin_dma(q, true, write, 512, 0, TABLE + 4);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, pages[0], fixture, 512);
+    check_bytes(q, pages[1], fixture + 512, 512);
+    if (write) {
+        select_data(q, false, 1024);
+        begin_dma(q, false, false, 1024, FLAT, 0);
+        reg_write(q, 3, 0x90);
+        wait_dma(q);
+        g_assert_cmphex(finish_command(q), ==, 0);
+        check_bytes(q, FLAT, fixture, 1024);
+    }
+    qtest_quit(q);
+}
+
+static void descriptor_error(void)
+{
+    QTestState *q = start();
+
+    begin_dma(q, true, false, 512, 0x123, 0xfef00000);
+    g_assert_cmphex(dma_read(q, 5) & (ERROR | ABORT | DONE), ==, ERROR | ABORT);
+    g_assert_cmphex(dma_read(q, 3), ==, 512);
+    g_assert_cmphex(dma_read(q, 4), ==, 0x123);
+    qtest_outl(q, 0xcf8, 0x80002004);
+    g_assert_cmphex(qtest_inl(q, 0xcfc) & (1U << 29), ==, 1U << 29);
+    /* A fresh START clears the error and translates a valid MDL. */
+    begin_dma(q, true, false, 512, 0x123, TABLE);
+    g_assert_cmphex(dma_read(q, 5) & (ERROR | ABORT | DONE), ==, 0);
+    g_assert_cmphex(dma_read(q, 4), ==, pages[0] + 0x123);
+    qtest_quit(q);
+}
+
+/* Recover an outstanding SCSI command after a failed descriptor/data access. */
+static void access_error(const void *opaque)
+{
+    unsigned test = GPOINTER_TO_UINT(opaque);
+    bool write = test & 1, next_descriptor = test & 2;
+    unsigned transferred = next_descriptor ? 512 : 0;
+    unsigned size = next_descriptor ? 1024 : 512;
+    QTestState *q = start();
+
+    qtest_memwrite(q, pages[0] + 3584, fixture, 512);
+    qtest_memwrite(q, pages[1], fixture + transferred, 512);
+    if (next_descriptor) {
+        /* Last DWORD of RAM: fetching the subsequent entry must fail. */
+        qtest_writel(q, 0xfffffc, pages[0]);
+    } else {
+        qtest_writel(q, TABLE, 0xfef00000);
+    }
+    select_data(q, write, size);
+    begin_dma(q, true, write, size, next_descriptor ? 3584 : 0,
+              next_descriptor ? 0xfffffc : TABLE);
+    reg_write(q, 3, 0x90);
+    for (unsigned i = 0; i < 100; i++) {
+        qtest_clock_step(q, 1000000);
+    }
+    g_assert_cmphex(dma_read(q, 5) & (ERROR | ABORT | DONE), ==, ERROR | ABORT);
+    g_assert_cmphex(dma_read(q, 3), ==, 512);
+    g_assert_cmphex(reg_read(q, 0) | reg_read(q, 1) << 8, ==, 512);
+    if (next_descriptor) {
+        check_bytes(q, pages[0] + 3584, fixture, 512);
+        g_assert_cmphex(dma_read(q, 7), ==, 0x1000000);
+    }
+    begin_dma(q, true, write, 512, 0, TABLE + 4);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, pages[1], fixture + transferred, 512);
+    if (write) {
+        select_data(q, false, size);
+        begin_dma(q, false, false, size, FLAT, 0);
+        reg_write(q, 3, 0x90);
+        wait_dma(q);
+        g_assert_cmphex(finish_command(q), ==, 0);
+        check_bytes(q, FLAT, fixture, size);
+    }
+    qtest_quit(q);
+}
+
+static void interrupts(void)
+{
+    QTestState *q = start();
+
+    /* Route all four PIIX PCI interrupt links to IRQ 11. */
+    qtest_outl(q, 0xcf8, 0x80000860);
+    qtest_outl(q, 0xcfc, 0x0b0b0b0b);
+    qtest_irq_intercept_in(q, "ioapic");
+    g_assert_false(qtest_get_irq(q, 11));
+    begin_dma(q, false, false, 0, FLAT, 0);
+    g_assert_false(qtest_get_irq(q, 11));
+    dma_write(q, 0, 0xc3); /* INTE_D enables DONE interrupt. */
+    g_assert_true(qtest_get_irq(q, 11));
+    g_assert_cmphex(dma_read(q, 5) & DONE, ==, DONE);
+    g_assert_false(qtest_get_irq(q, 11));
+    begin_dma(q, true, false, 512, 0, TABLE);
+    dma_write(q, 0, 0x92); /* ABORT interrupts independently of INTE_D. */
+    g_assert_true(qtest_get_irq(q, 11));
+    g_assert_cmphex(dma_read(q, 5) & ABORT, ==, ABORT);
+    g_assert_false(qtest_get_irq(q, 11));
+    dma_write(q, 0, 0x91);
+    g_assert_false(qtest_get_irq(q, 11));
+    g_assert_cmphex(dma_read(q, 5) & BLAST_COMPLETE, ==, BLAST_COMPLETE);
+    qtest_quit(q);
+}
+
+static void command_restart(void)
+{
+    QTestState *q = start();
+    uint8_t command[] = {0x80, 0x28, 0, 0, 0, 0, 0, 0, 0, 1, 0};
+
+    qtest_memwrite(q, FLAT, command, sizeof(command));
+    reg_write(q, 3, 1);
+    reg_write(q, 4, 0);
+    reg_write(q, 0, sizeof(command));
+    reg_write(q, 1, 0);
+    reg_write(q, 14, 0);
+    begin_dma(q, false, true, 1, FLAT, 0);
+    reg_write(q, 3, 0xc2); /* Select with ATN, DMA identify and CDB. */
+    g_assert_cmphex(dma_read(q, 3), ==, 0);
+    g_assert_cmphex(reg_read(q, 0), ==, sizeof(command) - 1);
+    begin_dma(q, false, true, sizeof(command) - 1, FLAT + 1, 0);
+    wait_dma(q);
+    g_assert_cmphex(reg_read(q, 0), ==, 0);
+    reg_read(q, 5);
+    reg_write(q, 0, 0);
+    reg_write(q, 1, 2);
+    begin_dma(q, false, false, 512, FLAT + 4096, 0);
+    reg_write(q, 3, 0x90);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, FLAT + 4096, fixture, 512);
+    qtest_quit(q);
+}
+
+/* A SCSI request can span several separate transfer-information commands. */
+static void scsi_segment(const void *opaque)
+{
+    bool write = GPOINTER_TO_UINT(opaque);
+    QTestState *q = start();
+
+    qtest_memwrite(q, pages[0], fixture, 512);
+    qtest_memwrite(q, pages[1], fixture + 512, 512);
+    select_data(q, write, 1024);
+    reg_write(q, 0, 0);
+    reg_write(q, 1, 2); /* SCSI transfer counter is only the first segment. */
+    begin_dma(q, true, write, 512, 0, TABLE);
+    reg_write(q, 3, 0x90);
+    wait_dma(q);
+    g_assert_cmphex(reg_read(q, 4) & 0x80, ==, 0x80);
+    g_assert_cmphex(reg_read(q, 5) & 0x10, ==,
+                    0x10); /* Next segment needs bus service. */
+    reg_write(q, 0, 0);
+    reg_write(q, 1, 2);
+    reg_write(q, 3, 0x90);
+    begin_dma(q, true, write, 512, 0, TABLE + 4);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, pages[0], fixture, 512);
+    check_bytes(q, pages[1], fixture + 512, 512);
+    if (write) {
+        select_data(q, false, 1024);
+        begin_dma(q, false, false, 1024, FLAT, 0);
+        reg_write(q, 3, 0x90);
+        wait_dma(q);
+        g_assert_cmphex(finish_command(q), ==, 0);
+        check_bytes(q, FLAT, fixture, 1024);
+    }
+    qtest_quit(q);
+}
+
+static void short_response(const void *opaque)
+{
+    unsigned size = GPOINTER_TO_UINT(opaque), i;
+    QTestState *q = start();
+    uint8_t cdb[] = {3, 0, 0, 0, size, 0};
+    uint8_t guard[4096];
+
+    memset(guard, GUARD, sizeof(guard));
+    reg_write(q, 3, 1);
+    reg_write(q, 4, 0);
+    reg_write(q, 2, 0x80);
+    for (i = 0; i < sizeof(cdb); i++) {
+        reg_write(q, 2, cdb[i]);
+    }
+    reg_write(q, 3, 0x42);
+    reg_read(q, 5);
+    reg_write(q, 0, 32);
+    reg_write(q, 1, 0);
+    begin_dma(q, true, false, 32, 4090, TABLE);
+    reg_write(q, 3, 0x90);
+    /* REQUEST SENSE is synchronous, and returns less than the DMA quota. */
+    g_assert_cmphex(dma_read(q, 3), ==, 32 - size);
+    g_assert_cmphex(reg_read(q, 0), ==, 32 - size);
+    g_assert_cmphex(qtest_readb(q, pages[0] + 4090), ==, 0x70);
+    check_bytes(q, pages[0], guard, 4090);
+    if (size <= 6) {
+        check_bytes(q, pages[0] + 4090 + size, guard, 6 - size);
+        check_bytes(q, pages[1], guard, 4096);
+    } else {
+        check_bytes(q, pages[1] + size - 6, guard, 4096 - (size - 6));
+    }
+    dma_write(q, 0,
+              0x91); /* Flush the empty DMA FIFO, not SCSI status bytes. */
+    g_assert_cmphex(dma_read(q, 5) & BLAST_COMPLETE, ==, BLAST_COMPLETE);
+    g_assert_cmphex(dma_read(q, 3), ==, 32 - size);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    qtest_quit(q);
+}
+
+static void pending_scsi_interrupt(void)
+{
+    QTestState *q = start();
+
+    reg_write(q, 3,
+              3); /* SCSI bus reset requests service from the SCSI core. */
+    g_assert_cmphex(dma_read(q, 5) & 0x10, ==, 0x10);
+    begin_dma(q, false, false, 0, FLAT, 0);
+    g_assert_cmphex(dma_read(q, 5) & 0x10, ==, 0x10);
+    reg_read(q, 4);
+    reg_read(q, 6);
+    reg_read(q, 5);
+    g_assert_cmphex(dma_read(q, 5) & 0x10, ==, 0);
+    qtest_quit(q);
+}
+
+static void idle_restart(void)
+{
+    QTestState *q = start();
+
+    select_data(q, false, 512);
+    begin_dma(q, true, false, 512, 0, TABLE);
+    dma_write(q, 0, 0x90); /* IDLE freezes the programmed DMA channel. */
+    reg_write(q, 3, 0x90);
+    for (unsigned i = 0; i < 10; i++) {
+        qtest_clock_step(q, 1000000);
+    }
+    g_assert_cmphex(dma_read(q, 3), ==, 512);
+    g_assert_cmphex(dma_read(q, 4), ==, pages[0]);
+    g_assert_cmphex(dma_read(q, 5) & (DONE | ABORT | ERROR), ==, 0);
+    begin_dma(q, true, false, 512, 0, TABLE);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, pages[0], fixture, 512);
+    qtest_quit(q);
+}
+
+static void reset_pending(const void *opaque)
+{
+    bool write = GPOINTER_TO_UINT(opaque);
+    QTestState *q = start();
+
+    qtest_memwrite(q, pages[0], fixture, 512);
+    select_data(q, write, 1024);
+    begin_dma(q, true, write, 512, 0, TABLE);
+    reg_write(q, 3, 0x90);
+    wait_dma(q);
+    g_assert_cmphex(reg_read(q, 0) | reg_read(q, 1) << 8, ==, 512);
+    qtest_qmp_assert_success(q, "{ 'execute': 'system_reset' }");
+    configure_pci(q);
+    g_assert_cmphex(dma_read(q, 3), ==, 0);
+    g_assert_cmphex(dma_read(q, 7), ==, 0xfffffffc);
+    g_assert_cmphex(dma_read(q, 5) & 0x3e, ==, 0);
+    /* Consume the reset UNIT ATTENTION through PIO status handling. */
+    for (unsigned i = 0; i < 2; i++) {
+        reg_write(q, 3, 1);
+        reg_write(q, 4, 0);
+        reg_write(q, 2, 0x80);
+        for (unsigned j = 0; j < 6; j++) {
+            reg_write(q, 2, 0);
+        }
+        reg_write(q, 3, 0x42);
+        g_assert_cmphex(finish_command(q), ==, i ? 0 : 2);
+    }
+    select_data(q, false, 512);
+    begin_dma(q, true, false, 512, 0, TABLE);
+    reg_write(q, 3, 0x90);
+    wait_dma(q);
+    g_assert_cmphex(finish_command(q), ==, 0);
+    check_bytes(q, pages[0], fixture, 512);
+    qtest_quit(q);
+}
+
+static void page_interrupt(void)
+{
+    QTestState *q = start();
+    uint8_t cdb[] = {3, 0, 0, 0, 17, 0};
+
+    qtest_outl(q, 0xcf8, 0x80000860);
+    qtest_outl(q, 0xcfc, 0x0b0b0b0b);
+    qtest_irq_intercept_in(q, "ioapic");
+    reg_write(q, 3, 1);
+    reg_write(q, 4, 0);
+    reg_write(q, 2, 0x80);
+    for (unsigned i = 0; i < sizeof(cdb); i++) {
+        reg_write(q, 2, cdb[i]);
+    }
+    reg_write(q, 3, 0x42);
+    reg_read(q, 5);
+    reg_write(q, 0, 32);
+    reg_write(q, 1, 0);
+    dma_write(q, 1, 32);
+    dma_write(q, 2, 4090);
+    dma_write(q, 6, TABLE);
+    dma_write(q, 0, 0xb3); /* MDL + INTE_P, with INTE_D clear. */
+    reg_write(q, 3, 0x90);
+    g_assert_cmphex(dma_read(q, 3), ==, 15);
+    g_assert_cmphex(dma_read(q, 7), ==, TABLE + 4);
+    reg_read(q, 4);
+    reg_read(q, 6);
+    reg_read(q, 5);                      /* Service the SCSI source. */
+    g_assert_true(qtest_get_irq(q, 11)); /* The page source remains pending. */
+    g_assert_cmphex(dma_read(q, 5), ==,
+                    0); /* Reserved status bits stay zero. */
+    g_assert_false(qtest_get_irq(q, 11));
+    g_assert_cmphex(finish_command(q), ==, 0);
+    qtest_quit(q);
+}
+
+static void wait_migration(QTestState *q, const char *expected)
+{
+    int64_t deadline = g_get_monotonic_time() + 10 * G_TIME_SPAN_SECOND;
+    bool done;
+
+    do {
+        QDict *response =
+            qtest_qmp_assert_success_ref(q, "{ 'execute': 'query-migrate' }");
+        const char *status = qdict_get_str(response, "status");
+        g_assert_cmpstr(status, !=,
+                        !strcmp(expected, "failed") ? "completed" : "failed");
+        done = !strcmp(status, expected);
+        qobject_unref(response);
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        if (!done) {
+            g_usleep(1000);
+        }
+    } while (!done);
+}
+
+static void corrupt_dma_state(const char *path, unsigned scenario)
+{
+    const char signature[] = "\x05\x07"
+                             "esp/dma";
+    char *data;
+    gsize size, i;
+    bool found = false;
+
+    g_assert_true(g_file_get_contents(path, &data, &size, NULL));
+    for (i = 0; i + sizeof(signature) - 1 + 4 + 13 <= size; i++) {
+        if (!memcmp(data + i, signature, sizeof(signature) - 1)) {
+            char *fields = data + i + sizeof(signature) - 1 + 4;
+            if (scenario == 4) {
+                fields[3] = 2; /* Invalid DMA enable value. */
+            } else if (scenario == 5) {
+                fields[4] = 0xff; /* Unknown continuation. */
+            } else {
+                memset(fields + (scenario == 6 ? 9 : 5), 0xff, 4);
+            }
+            found = true;
+            break;
+        }
+    }
+    g_assert_true(found);
+    g_assert_true(g_file_set_contents(path, data, size, NULL));
+    g_free(data);
+}
+
+static void migration_ready(const void *opaque)
+{
+    unsigned scenario = GPOINTER_TO_UINT(opaque);
+    bool write_data = scenario == 2;
+    QTestState *from = start(), *to;
+    char *state_path, *target_disk;
+    g_autofree char *uri = NULL;
+    int fd = g_file_open_tmp("am53c974-state-XXXXXX", &state_path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    fd = g_file_open_tmp("am53c974-target-XXXXXX", &target_disk, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(write(fd, fixture, sizeof(fixture)), ==, sizeof(fixture));
+    close(fd);
+    uri = g_strdup_printf("file:%s", state_path);
+    if (scenario == 8) {
+        uint8_t command[] = {0x80, 0x28, 0, 0, 0, 0, 0, 0, 0, 1, 0};
+        qtest_memwrite(from, FLAT, command, sizeof(command));
+        reg_write(from, 3, 1);
+        reg_write(from, 4, 0);
+        reg_write(from, 0, sizeof(command));
+        reg_write(from, 1, 0);
+        reg_write(from, 14, 0);
+        begin_dma(from, false, true, 1, FLAT, 0);
+        reg_write(from, 3, 0xc2);
+    } else if (scenario == 3) {
+        uint8_t cdb[] = {3, 0, 0, 0, 17, 0};
+        qtest_outl(from, 0xcf8, 0x80000860);
+        qtest_outl(from, 0xcfc, 0x0b0b0b0b);
+        reg_write(from, 3, 1);
+        reg_write(from, 4, 0);
+        reg_write(from, 2, 0x80);
+        for (unsigned i = 0; i < sizeof(cdb); i++) {
+            reg_write(from, 2, cdb[i]);
+        }
+        reg_write(from, 3, 0x42);
+        reg_read(from, 5);
+        reg_write(from, 0, 32);
+        reg_write(from, 1, 0);
+        begin_dma(from, true, false, 32, 4090, TABLE);
+        dma_write(from, 0, 0xb3);
+        reg_write(from, 3, 0x90);
+        reg_read(from, 4);
+        reg_read(from, 6);
+        reg_read(from, 5);
+    } else if (scenario) {
+        qtest_memwrite(from, pages[0], fixture, 512);
+        qtest_memwrite(from, pages[1], fixture + 512, 512);
+        select_data(from, write_data, 1024);
+        begin_dma(from, true, write_data, 512, 0, TABLE);
+        reg_write(from, 3, 0x90);
+        wait_dma(from);
+    } else {
+        begin_dma(from, true, false, 512, 17, TABLE);
+    }
+    qtest_qmp_assert_success(
+        from, "{ 'execute': 'migrate', 'arguments': { 'uri': %s } }", uri);
+    wait_migration(from, "completed");
+    qtest_quit(from);
+    if (scenario >= 4 && scenario <= 7) {
+        corrupt_dma_state(state_path, scenario);
+    }
+    to = qtest_initf(
+        "-machine pc -nodefaults -m 16 -device am53c974,addr=04.0,id=scsi "
+        "-drive file=%s,format=raw,if=none,id=disk,cache=writeback "
+        "-device scsi-hd,drive=disk,bus=scsi.0,scsi-id=0 -incoming defer",
+        target_disk);
+    qtest_irq_intercept_in(to, "ioapic");
+    qtest_qmp_assert_success(
+        to,
+        "{ 'execute': 'migrate-incoming', 'arguments': { 'uri': %s, "
+        "'exit-on-error': false } }",
+        uri);
+    if (scenario >= 4 && scenario <= 7) {
+        wait_migration(to, "failed");
+        goto cleanup;
+    }
+    wait_migration(to, "completed");
+    if (scenario == 8) {
+        begin_dma(to, false, true, 10, FLAT + 1, 0);
+        wait_dma(to);
+        reg_read(to, 5);
+        reg_write(to, 0, 0);
+        reg_write(to, 1, 2);
+        begin_dma(to, false, false, 512, FLAT + 4096, 0);
+        reg_write(to, 3, 0x90);
+        wait_dma(to);
+        g_assert_cmphex(finish_command(to), ==, 0);
+        check_bytes(to, FLAT + 4096, fixture, 512);
+    } else if (scenario == 3) {
+        g_assert_cmphex(dma_read(to, 3), ==, 15);
+        dma_write(to, 0, 0x90); /* Mask INTE_P without clearing its event. */
+        g_assert_false(qtest_get_irq(to, 11));
+        dma_write(to, 0, 0xb0);
+        g_assert_true(qtest_get_irq(to, 11));
+        g_assert_cmphex(dma_read(to, 5), ==, 0);
+        g_assert_false(qtest_get_irq(to, 11));
+        g_assert_cmphex(finish_command(to), ==, 0);
+    } else if (scenario) {
+        g_assert_cmphex(dma_read(to, 3), ==, 0);
+        g_assert_cmphex(reg_read(to, 0) | reg_read(to, 1) << 8, ==, 512);
+        begin_dma(to, true, write_data, 512, 0, TABLE + 4);
+        wait_dma(to);
+        g_assert_cmphex(finish_command(to), ==, 0);
+        check_bytes(to, pages[1], fixture + 512, 512);
+        if (write_data) {
+            select_data(to, false, 1024);
+            begin_dma(to, false, false, 1024, FLAT, 0);
+            reg_write(to, 3, 0x90);
+            wait_dma(to);
+            g_assert_cmphex(finish_command(to), ==, 0);
+            check_bytes(to, FLAT, fixture, 1024);
+        }
+    } else {
+        g_assert_cmphex(dma_read(to, 3), ==, 512);
+        g_assert_cmphex(dma_read(to, 4), ==, pages[0] + 17);
+        g_assert_cmphex(dma_read(to, 7), ==, TABLE);
+        select_data(to, false, 512);
+        reg_write(to, 3, 0x90); /* No second START: enabled DMA must survive. */
+        wait_dma(to);
+        g_assert_cmphex(finish_command(to), ==, 0);
+        check_bytes(to, pages[0] + 17, fixture, 512);
+    }
+cleanup:
+    qtest_quit(to);
+    unlink(state_path);
+    unlink(target_disk);
+    g_free(state_path);
+    g_free(target_disk);
+}
