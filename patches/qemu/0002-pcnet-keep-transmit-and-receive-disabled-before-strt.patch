Subject: [PATCH 2/30] pcnet: keep transmit and receive disabled before STRT

STOP incorrectly retained TXON, allowing TDMD after reinitialization to
consume transmit descriptors before STRT. Receive also accepted frames with
RXON clear. This can deliver startup traffic while the guest has not enabled
its receive path.

Clear CSR0 to STOP and reject frames while reception is disabled. Do not
retain initialization-time traffic for later delivery. Test STOP after STRT,
pre-start TDMD, pre-start RX, and STOP/reinitialization without resurrecting
rejected traffic. Keep the existing internal migration layout.

---
diff --git a/hw/net/pcnet.c b/hw/net/pcnet.c
index 3e65a3b..22e7c52 100644
--- a/hw/net/pcnet.c
+++ b/hw/net/pcnet.c
@@ -863,8 +863,7 @@ static void pcnet_stop(PCNetState *s)
 #ifdef PCNET_DEBUG
     printf("pcnet_stop\n");
 #endif
-    s->csr[0] &= ~0xffeb;
-    s->csr[0] |= 0x0014;
+    s->csr[0] = 0x0004;
     s->csr[4] &= ~0x02c2;
     s->csr[5] &= ~0x0011;
     pcnet_poll_timer(s);
@@ -991,7 +990,7 @@ ssize_t pcnet_receive(NetClientState *nc, const uint8_t *buf, size_t size_)
     int crc_err = 0;
     size_t size = size_;
 
-    if (CSR_DRX(s) || CSR_STOP(s) || CSR_SPND(s) || !size ||
+    if (!CSR_RXON(s) || CSR_DRX(s) || CSR_STOP(s) || CSR_SPND(s) || !size ||
         (CSR_LOOP(s) && !s->looptest)) {
         return -1;
     }
diff --git a/tests/qtest/pcnet-test.c b/tests/qtest/pcnet-test.c
index cdf155b..6b79674 100644
--- a/tests/qtest/pcnet-test.c
+++ b/tests/qtest/pcnet-test.c
@@ -113,6 +113,24 @@ static void pcnet_ring_lengths(void *obj, void *data, QGuestAllocator *alloc)
     }
 }
 
+static void pcnet_stopped_transmitter(void *obj, void *data,
+                                      QGuestAllocator *alloc)
+{
+    QPCNet *pcnet = obj;
+    QPCIDevice *dev = &pcnet->dev;
+    QPCIBar io;
+
+    qpci_device_enable(dev);
+    io = qpci_iomap(dev, 0, NULL);
+    pcnet_csr_write(dev, io, 0, 4);
+    /* STOP must clear TXON and RXON, including after STRT. */
+    g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x34, ==, 4);
+    pcnet_csr_write(dev, io, 0, 2);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x30, ==, 0x30);
+    pcnet_csr_write(dev, io, 0, 4);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x34, ==, 4);
+}
+
 static void pcnet_tx_ring(void *obj, void *data, QGuestAllocator *alloc)
 {
     QPCNet *pcnet = obj;
@@ -124,6 +142,7 @@ static void pcnet_tx_ring(void *obj, void *data, QGuestAllocator *alloc)
     uint64_t buffer_addr = guest_alloc(alloc, 64);
     uint8_t init[32] = { 0 }, tmd[16] = { 0 }, packet[64] = { 0 };
     unsigned i;
+    bool startup = GPOINTER_TO_UINT(data);
 
     qpci_device_enable(dev);
     io = qpci_iomap(dev, 0, NULL);
@@ -140,6 +159,11 @@ static void pcnet_tx_ring(void *obj, void *data, QGuestAllocator *alloc)
     for (i = 0; i < 2; i++) {
         qtest_memwrite(qts, tx_addr + i * 16, tmd, sizeof(tmd));
     }
+    if (startup) {
+        /* Reproduce STOP after a previous start, then initialize again. */
+        pcnet_csr_write(dev, io, 0, 2);
+        pcnet_csr_write(dev, io, 0, 4);
+    }
     pcnet_csr_write(dev, io, 1, init_addr);
     pcnet_csr_write(dev, io, 2, init_addr >> 16);
     pcnet_csr_write(dev, io, 0, 1);
@@ -147,6 +171,14 @@ static void pcnet_tx_ring(void *obj, void *data, QGuestAllocator *alloc)
     g_assert_cmphex(pcnet_csr_read(dev, io, 78), ==, 0xfffe);
     pcnet_csr_write(dev, io, 78, 0xfffe);
     pcnet_csr_write(dev, io, 5, 0);
+    if (startup) {
+        pcnet_csr_write(dev, io, 0, 8); /* TDMD while TXON is clear. */
+        for (i = 0; i < 2; i++) {
+            g_assert_cmphex(qtest_readw(qts, tx_addr + i * 16 + 6) & 0x8000,
+                            ==, 0x8000);
+        }
+        g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x208, ==, 0);
+    }
     pcnet_csr_write(dev, io, 0, 0x102);
     pcnet_csr_write(dev, io, 0, 8);
     for (i = 0; i < 2; i++) {
@@ -165,6 +197,7 @@ static void pcnet_tx_ring(void *obj, void *data, QGuestAllocator *alloc)
 typedef struct PCNetRxContext {
     int sockets[2];
     char *dump_path;
+    unsigned scenario;
     off_t dump_size;
 } PCNetRxContext;
 
@@ -185,6 +218,7 @@ static void *pcnet_rx_setup(GString *cmd_line, void *arg)
     PCNetRxContext *ctx = g_new0(PCNetRxContext, 1);
     int fd = g_file_open_tmp("pcnet-rx-XXXXXX", &ctx->dump_path, NULL);
 
+    ctx->scenario = GPOINTER_TO_UINT(arg);
     ctx->dump_size = 24;
 
     g_assert_cmpint(fd, >=, 0);
@@ -232,7 +266,7 @@ static void pcnet_rx_startup(void *obj, void *data, QGuestAllocator *alloc)
     PCNetRxContext *ctx = data;
     QTestState *qts = global_qtest;
     QPCIBar io;
-    unsigned count = 2;
+    unsigned count = ctx->scenario == 1 ? 2 : 1;
     uint64_t init_addr = guest_alloc(alloc, 32);
     uint64_t rx_addr = guest_alloc(alloc, count * 16);
     uint64_t tx_addr = guest_alloc(alloc, count * 16);
@@ -264,16 +298,24 @@ static void pcnet_rx_startup(void *obj, void *data, QGuestAllocator *alloc)
     pcnet_csr_write(dev, io, 2, init_addr >> 16);
     pcnet_csr_write(dev, io, 0, 1);
 
-
-    /* Program valid ring lengths while suspended, then exercise wrap. */
-    pcnet_csr_write(dev, io, 5, 1);
-    g_assert_cmphex(pcnet_csr_read(dev, io, 76), ==, 0xfffe);
-    g_assert_cmphex(pcnet_csr_read(dev, io, 78), ==, 0xfffe);
-    pcnet_csr_write(dev, io, 76, 0xfffe);
-    pcnet_csr_write(dev, io, 78, 0xfffe);
-    pcnet_csr_write(dev, io, 5, 0);
-
-
+    if (ctx->scenario == 1) {
+        /* Program valid ring lengths while suspended, then exercise wrap. */
+        pcnet_csr_write(dev, io, 5, 1);
+        g_assert_cmphex(pcnet_csr_read(dev, io, 76), ==, 0xfffe);
+        g_assert_cmphex(pcnet_csr_read(dev, io, 78), ==, 0xfffe);
+        pcnet_csr_write(dev, io, 76, 0xfffe);
+        pcnet_csr_write(dev, io, 78, 0xfffe);
+        pcnet_csr_write(dev, io, 5, 0);
+    } else {
+        packet[63] = 0x5a;
+        pcnet_send_frame(ctx, packet, sizeof(packet));
+        g_assert_cmphex(qtest_readw(qts, rx_addr + 6) & 0x8000, ==, 0x8000);
+        g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x400, ==, 0);
+        if (ctx->scenario == 2) {
+            pcnet_csr_write(dev, io, 0, 4);
+            pcnet_csr_write(dev, io, 0, 1);
+        }
+    }
     pcnet_csr_write(dev, io, 0, 0x142);
     /* Starting must not resurrect the rejected pre-start frame. */
     g_assert_cmphex(qtest_readw(qts, rx_addr + 6) & 0x8000, ==, 0x8000);
@@ -297,14 +339,23 @@ static void pcnet_rx_startup(void *obj, void *data, QGuestAllocator *alloc)
 
 static void pcnet_register_nodes(void)
 {
-    QOSGraphEdgeOptions opts = { .extra_device_opts = "addr=04.0" };
-
+    QOSGraphEdgeOptions opts = {
+        .extra_device_opts = "addr=04.0",
+    };
     add_qpci_address(&opts, &(QPCIAddress) { .devfn = QPCI_DEVFN(4, 0) });
+
     qos_node_create_driver("pcnet", pcnet_create);
     qos_node_consumes("pcnet", "pci-bus", &opts);
     qos_node_produces("pcnet", "pci-device");
     qos_add_test("ring-length-encoding", "pcnet", pcnet_ring_lengths, NULL);
+    qos_add_test("stopped-transmitter", "pcnet", pcnet_stopped_transmitter,
+                 NULL);
     qos_add_test("tx-manual-ring-wrap", "pcnet", pcnet_tx_ring, NULL);
+    {
+        QOSGraphTestOptions tx_opts = { .arg = GUINT_TO_POINTER(1) };
+
+        qos_add_test("tx-startup-ring-wrap", "pcnet", pcnet_tx_ring, &tx_opts);
+    }
 #ifndef _WIN32
     {
         QOSGraphTestOptions test_opts = {
@@ -312,8 +363,13 @@ static void pcnet_register_nodes(void)
             .edge.extra_device_opts = "netdev=pcnet-test-net",
         };
 
+        qos_add_test("rx-disabled-before-start", "pcnet", pcnet_rx_startup,
+                     &test_opts);
+        test_opts.arg = GINT_TO_POINTER(1);
         qos_add_test("rx-manual-ring-wrap", "pcnet", pcnet_rx_startup,
                      &test_opts);
+        test_opts.arg = GUINT_TO_POINTER(2);
+        qos_add_test("rx-stop-reinit", "pcnet", pcnet_rx_startup, &test_opts);
     }
 #endif
 }
