     install_iaq_entries(ctx, &ctx->iaq_f, &ctx->iaq_b);
     nullify_save(ctx);
-    gen_excp_1(exception);
+    gen_excp_1(ctx, exception);
     ctx->base.is_jmp = DISAS_NORETURN;
 }
 
