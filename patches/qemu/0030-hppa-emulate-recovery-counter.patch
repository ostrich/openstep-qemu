Subject: [PATCH 30/30] target/hppa: implement recovery-counter stepping

CR0 and PSW R were stored but did not decrement or generate a recovery trap.
NEXTSTEP PT_STEP consequently ran through to process exit.

Count non-nullified instructions, restore the count on pre-completion faults,
and deliver recovery traps before fetching the following instruction. Keep
normal translation-block chaining when recovery counting is disabled. Reuse
existing migrated CPU state.

diff --git a/target/hppa/cpu.c b/target/hppa/cpu.c
index a68152f..8a84972 100644
--- a/target/hppa/cpu.c
+++ b/target/hppa/cpu.c
@@ -83,9 +83,12 @@ static TCGTBCPUState hppa_get_tb_cpu_state(CPUState *cs)
     }
 
     /* ??? E, T, H, L bits need to be here, when implemented.  */
+    if ((env->psw & PSW_R) && (int32_t)env->cr[CR_RC] < 0) {
+        flags |= TB_FLAG_RC_NEG;
+    }
     flags |= env->psw_n * PSW_N;
     flags |= env->psw_xb;
-    flags |= env->psw & (PSW_W | PSW_C | PSW_D | PSW_P);
+    flags |= env->psw & (PSW_W | PSW_C | PSW_D | PSW_P | PSW_R);
 
 #ifdef CONFIG_USER_ONLY
     flags |= TB_FLAG_UNALIGN * !env_cpu(env)->prctl_unalign_sigbus;
@@ -124,7 +127,11 @@ static void hppa_restore_state_to_opc(CPUState *cs,
     if (data[1] != INT32_MIN) {
         env->iaoq_b = env->iaoq_f + data[1];
     }
-    env->unwind_breg = data[2];
+    env->unwind_breg = data[2] & 31;
+    if (data[2] & HPPA_INSN_RC_COUNTED) {
+        /* The faulting instruction did not complete. Restore CR0. */
+        env->cr[CR_RC] = (uint32_t)(env->cr[CR_RC] + 1);
+    }
     /*
      * Since we were executing the instruction at IAOQ_F, and took some
      * sort of action that provoked the cpu_restore_state, we can infer
diff --git a/target/hppa/cpu.h b/target/hppa/cpu.h
index f453444..0eb97ae 100644
--- a/target/hppa/cpu.h
+++ b/target/hppa/cpu.h
@@ -370,6 +370,9 @@ hwaddr hppa_abs_to_phys_pa2_w1(uint8_t phys_addr_bits, vaddr addr);
 #define TB_FLAG_PRIV_SHIFT  8
 #define TB_FLAG_UNALIGN     0x400
 #define TB_FLAG_SPHASH      0x800
+#define TB_FLAG_RC_NEG      0x1000
+/* Bit in insn_start parameter 2, alongside the five-bit base register. */
+#define HPPA_INSN_RC_COUNTED 0x100
 #define CS_BASE_DIFFPAGE    (1 << 12)
 #define CS_BASE_DIFFSPACE   (1 << 13)
 
diff --git a/target/hppa/int_helper.c b/target/hppa/int_helper.c
index 3e87b9a..de4c53f 100644
--- a/target/hppa/int_helper.c
+++ b/target/hppa/int_helper.c
@@ -302,6 +302,13 @@ bool hppa_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
         return true;
     }
 
+    /* Recovery counter traps precede external interrupts, independently of I. */
+    if ((env->psw & PSW_R) && (int32_t)env->cr[CR_RC] < 0) {
+        cs->exception_index = EXCP_RC;
+        hppa_cpu_do_interrupt(cs);
+        return true;
+    }
+
     /* If interrupts are requested and enabled, raise them.  */
     if ((interrupt_request & CPU_INTERRUPT_HARD)
         && (env->psw & PSW_I)
