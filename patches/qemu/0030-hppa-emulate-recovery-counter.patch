-static void gen_excp_1(int exception)
+static void gen_excp_1(DisasContext *ctx, int exception)
 {
+    if (ctx->rc_counted
+        && ((exception >= EXCP_HPMC && exception <= EXCP_ASSIST_EMU)
+            || (exception >= EXCP_DMAR && exception <= EXCP_PER_INTERRUPT))) {
+        /* Explicit group 1/2/3 exceptions bypass restore_state_to_opc. */
+        TCGv_i64 rc = tcg_temp_new_i64();
+        tcg_gen_ld_i64(rc, tcg_env, offsetof(CPUHPPAState, cr[CR_RC]));
+        tcg_gen_addi_i64(rc, rc, 1);
+        tcg_gen_ext32u_i64(rc, rc);
+        tcg_gen_st_i64(rc, tcg_env, offsetof(CPUHPPAState, cr[CR_RC]));
+    }
     gen_helper_excp(tcg_env, tcg_constant_i32(exception));
 }
 
@@ -733,7 +745,7 @@ static void gen_excp(DisasContext *ctx, int exception)
