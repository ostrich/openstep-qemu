                               | DMA_CMD_MDL | DMA_CMD_DIAG | DMA_CMD_MASK);
-    pci->dma_regs[DMA_WBC] &= ~0xffff;
+    pci->dma_regs[DMA_WBC] = 0;
     pci->dma_regs[DMA_WAC] = 0xffffffff;
     pci->dma_regs[DMA_STAT] &= ~(DMA_STAT_BCMBLT | DMA_STAT_SCSIINT
                                | DMA_STAT_DONE | DMA_STAT_ABORT
                                | DMA_STAT_ERROR);
