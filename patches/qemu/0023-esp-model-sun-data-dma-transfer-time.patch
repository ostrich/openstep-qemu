diff --git a/tests/qtest/esp-timing-test.c b/tests/qtest/esp-timing-test.c
new file mode 100644
index 0000000..2cbf80b
--- /dev/null
+++ b/tests/qtest/esp-timing-test.c
@@ -0,0 +1,321 @@
+/* Sun ESP aggregate DMA timing. SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define ESP 0x78800000
+#define DMA 0x78400000
+#define BUFFER 0x100000
+#define TABLE 0x20000
+#define IOADDR 0xff000000
+#define NS (512 * 200)
+static char *disk;
+static uint8_t fixture[512];
+
+static void wr(QTestState *q, unsigned reg, uint8_t value)
+{
+    qtest_writeb(q, ESP + reg * 4, value);
+}
+
+static uint8_t rd(QTestState *q, unsigned reg)
+{
+    return qtest_readb(q, ESP + reg * 4);
+}
+
+static uint8_t finish(QTestState *q)
+{
+    uint8_t status;
+
+    rd(q, 5);
+    wr(q, 3, 0x11);
+    rd(q, 5);
+    status = rd(q, 2);
+    g_assert_cmphex(rd(q, 2), ==, 0);
+    wr(q, 3, 0x12);
+    rd(q, 5);
+    return status;
+}
+
+static QTestState *start(bool incoming)
+{
+    QTestState *q = qtest_initf(
+        "-machine SS-5 -m 64 -display none %s "
+        "-drive if=none,id=disk,file=%s,format=raw "
+        "-device scsi-hd,drive=disk,scsi-id=0,share-rw=on",
+        incoming ? "-incoming defer" : "", disk);
+    if (incoming) {
+        return q;
+    }
+    /* 16 MiB I/O window, first page mapped to BUFFER. */
+    qtest_writel(q, 0x10000004, TABLE >> 4);
+    qtest_writel(q, TABLE, (BUFFER >> 4) | 6);
+    qtest_writel(q, 0x10000000, 1);
+    for (int i = 0; i < 2; i++) {
+        wr(q, 3, 1);
+        wr(q, 4, 0);
+        wr(q, 2, 0x80);
+        for (int j = 0; j < 6; j++) {
+            wr(q, 2, 0);
+        }
+        wr(q, 3, 0x42);
+        g_assert_cmphex(finish(q), ==, i ? 0 : 2);
+    }
+    return q;
+}
+
+static void select_data(QTestState *q, bool write_data, uint8_t lba)
+{
+    uint8_t cdb[] = {0x28, 0, 0, 0, 0, 0, 0, 0, 1, 0};
+    cdb[0] = write_data ? 0x2a : 0x28;
+    cdb[5] = lba;
+    wr(q, 3, 1);
+    wr(q, 4, 0);
+    wr(q, 2, 0x80);
+    for (unsigned i = 0; i < sizeof(cdb); i++) {
+        wr(q, 2, cdb[i]);
+    }
+    wr(q, 3, 0x42);
+    int64_t deadline = g_get_monotonic_time() + 5 * G_TIME_SPAN_SECOND;
+    while (!(rd(q, 4) & 0x80)) {
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        qtest_clock_step(q, 1000);
+    }
+    rd(q, 5);
+    if (write_data) {
+        qtest_memwrite(q, BUFFER, fixture, 512);
+    } else {
+        qtest_memset(q, BUFFER, 0xa5, 512);
+    }
+    qtest_writel(q, DMA + 4, IOADDR);
+    qtest_writel(q, DMA, write_data ? 0x210 : 0x310);
+    wr(q, 0, 0);
+    wr(q, 1, 2);
+    wr(q, 3, 0x90);
+}
+
+static void unchanged(QTestState *q)
+{
+    uint8_t actual[512], expected[512];
+    memset(expected, 0xa5, sizeof(expected));
+    qtest_memread(q, BUFFER, actual, sizeof(actual));
+    g_assert_cmpmem(actual, sizeof(actual), expected, sizeof(expected));
+}
+
+static void transferred(QTestState *q)
+{
+    uint8_t actual[512];
+    qtest_memread(q, BUFFER, actual, sizeof(actual));
+    g_assert_cmpmem(actual, sizeof(actual), fixture, sizeof(fixture));
+    g_assert_cmphex(finish(q), ==, 0);
+}
+
+static void timing(void)
+{
+    QTestState *q = start(false);
+    select_data(q, false, 0);
+    unchanged(q);
+    qtest_clock_step(q, NS - 1);
+    unchanged(q);
+    qtest_clock_step(q, 1);
+    transferred(q);
+    qtest_quit(q);
+}
+
+static void cancel(const void *opaque)
+{
+    unsigned kind = GPOINTER_TO_UINT(opaque);
+    QTestState *q = start(false);
+    select_data(q, false, 0);
+    switch (kind) {
+    case 0: /* Chip reset. */
+        wr(q, 3, 2);
+        break;
+    case 1: /* SCSI bus reset. */
+        wr(q, 3, 3);
+        break;
+    case 2: /* Replacement command. */
+        wr(q, 3, 0);
+        break;
+    case 3: /* Parent reset line. */
+        qtest_writel(q, DMA, 0x80);
+        break;
+    case 4:
+        qtest_qmp_assert_success(q, "{'execute':'system_reset'}");
+        break;
+    }
+    qtest_clock_step(q, NS * 2);
+    unchanged(q);
+    if (kind == 2) {
+        /* A new TI must not inherit a canceled command's deadline. */
+        wr(q, 3, 0x90);
+        qtest_clock_step(q, NS - 1);
+        unchanged(q);
+        qtest_clock_step(q, 1);
+        transferred(q);
+    }
+    qtest_quit(q);
+}
+
+static void disabled(void)
+{
+    QTestState *q = start(false);
+    select_data(q, false, 0);
+    qtest_writel(q, DMA, 0x110);
+    qtest_clock_step(q, NS * 2);
+    unchanged(q);
+    qtest_writel(q, DMA, 0x310);
+    transferred(q);
+    qtest_quit(q);
+}
+
+static void write_read(void)
+{
+    QTestState *q = start(false);
+    select_data(q, true, 1);
+    qtest_clock_step(q, NS);
+    int64_t deadline = g_get_monotonic_time() + 5 * G_TIME_SPAN_SECOND;
+    while (!(rd(q, 4) & 0x80)) {
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        qtest_clock_step(q, 1000);
+    }
+    g_assert_cmphex(finish(q), ==, 0);
+    select_data(q, false, 1);
+    unchanged(q);
+    qtest_clock_step(q, NS);
+    transferred(q);
+    qtest_quit(q);
+}
+
+static void wait_migration(QTestState *q, bool failed)
+{
+    int64_t deadline = g_get_monotonic_time() + 10 * G_TIME_SPAN_SECOND;
+    while (true) {
+        QDict *reply = qtest_qmp_assert_success_ref(
+            q, "{'execute':'query-migrate'}");
+        const char *state = qdict_get_str(reply, "status");
+        bool done = !strcmp(state, failed ? "failed" : "completed");
+        g_assert_cmpstr(state, !=, failed ? "completed" : "failed");
+        qobject_unref(reply);
+        if (done) {
+            return;
+        }
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        g_usleep(1000);
+    }
+}
+
+static void migrate(const void *opaque)
+{
+    unsigned mode = GPOINTER_TO_UINT(opaque);
+    bool write_data = mode == 1;
+    QTestState *from = start(false), *to;
+    g_autofree char *path = NULL;
+    int fd = g_file_open_tmp("esp-timing-migration-XXXXXX", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    g_autofree char *out = g_strdup_printf("file:%s", path);
+    select_data(from, write_data, write_data ? 1 : 0);
+    if (mode == 2) {
+        qtest_writel(from, DMA, 0x110);
+    }
+    int64_t expires = qtest_clock_step(from, NS / 2) + NS / 2;
+    if (!write_data) {
+        unchanged(from);
+    }
+    qtest_qmp_assert_success(
+        from, "{'execute':'migrate','arguments':{'uri':%s}}", out);
+    wait_migration(from, false);
+    qtest_quit(from);
+    if (mode >= 3) {
+        gchar *data;
+        gsize len;
+        const char section[] = "esp/transfer-timer";
+        g_assert_true(g_file_get_contents(path, &data, &len, NULL));
+        char *record = NULL;
+        /* Migration streams contain NULs; do not use a string search. */
+        for (gsize i = 0; i + strlen(section) <= len; i++) {
+            if (memcmp(data + i, section, strlen(section)) == 0) {
+                record = data + i;
+                break;
+            }
+        }
+        g_assert_nonnull(record);
+        record += strlen(section) + 4; /* subsection name, then version */
+        g_assert_true(record + 12 <= data + len);
+        g_assert_cmphex((uint8_t)record[3], ==, 200);
+        if (mode == 3) {
+            memset(record, 0, 4); /* configuration mismatch */
+        } else {
+            /* Inactive timer in an active subsection. */
+            memset(record + 4, 0xff, 8);
+        }
+        g_assert_true(g_file_set_contents(path, data, len, NULL));
+        g_free(data);
+    }
+    to = start(true);
+    qtest_qmp_assert_success(to,
+        "{'execute':'migrate-incoming','arguments':{'uri':%s,"
+        "'exit-on-error':false}}", out);
+    wait_migration(to, mode >= 3);
+    if (mode >= 3) {
+        qtest_quit(to);
+        unlink(path);
+        return;
+    }
+    if (!write_data) {
+        unchanged(to);
+    }
+    qtest_clock_set(to, expires - 1);
+    if (!write_data) {
+        unchanged(to);
+    }
+    qtest_clock_step(to, 1);
+    if (mode == 2) {
+        unchanged(to);
+        qtest_writel(to, DMA, 0x310);
+    }
+    if (write_data) {
+        int64_t deadline = g_get_monotonic_time() + 5 * G_TIME_SPAN_SECOND;
+        while (!(rd(to, 4) & 0x80)) {
+            g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+            qtest_clock_step(to, 1000);
+        }
+        g_assert_cmphex(finish(to), ==, 0);
+        select_data(to, false, 1);
+        qtest_clock_step(to, NS);
+    }
+    transferred(to);
+    qtest_quit(to);
+    unlink(path);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    int fd = g_file_open_tmp("esp-timing-disk-XXXXXX", &disk, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    for (unsigned i = 0; i < sizeof(fixture); i++) {
+        fixture[i] = i * 37;
+    }
+    g_assert_cmpint(write(fd, fixture, sizeof(fixture)), ==, sizeof(fixture));
+    g_assert_cmpint(ftruncate(fd, 1024 * 1024), ==, 0);
+    close(fd);
+    qtest_add_func("/esp/timing", timing);
+    for (unsigned i = 0; i < 5; i++) {
+        g_autofree char *name = g_strdup_printf("/esp/cancel/%u", i);
+        qtest_add_data_func(name, GUINT_TO_POINTER(i), cancel);
+    }
+    qtest_add_func("/esp/dma-disabled", disabled);
+    qtest_add_func("/esp/write-read-integrity", write_read);
+    qtest_add_data_func("/esp/migration/read", GUINT_TO_POINTER(0), migrate);
+    qtest_add_data_func("/esp/migration/write", GUINT_TO_POINTER(1), migrate);
+    qtest_add_data_func("/esp/migration/dma-disabled",
+                        GUINT_TO_POINTER(2), migrate);
+    qtest_add_data_func("/esp/migration/invalid-rate",
+                        GUINT_TO_POINTER(3), migrate);
+    qtest_add_data_func("/esp/migration/invalid-timer",
+                        GUINT_TO_POINTER(4), migrate);
+    int ret = g_test_run();
+    unlink(disk);
+    g_free(disk);
+    return ret;
+}
