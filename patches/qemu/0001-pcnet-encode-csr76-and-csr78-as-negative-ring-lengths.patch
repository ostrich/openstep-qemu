Subject: [PATCH 1/31] pcnet: encode CSR76 and CSR78 as negative ring lengths

CSR76 and CSR78 expose 16-bit two's-complement descriptor counts. The
emulator stores positive counts internally, including lengths loaded from
initialization blocks, so direct guest writes previously changed the internal
length to the raw negative encoding and walked outside the intended ring.

Translate reads and writes at the register boundary. Preserve the existing
zero-to-512 fallback for the invalid zero encoding. Test initialization styles
0 and 2, valid count boundaries, and manually programmed RX/TX ring wrap.
Internal and migrated state representation remain unchanged.

---
diff --git a/hw/net/pcnet.c b/hw/net/pcnet.c
index 0bd7d43..3e65a3b 100644
--- a/hw/net/pcnet.c
+++ b/hw/net/pcnet.c
@@ -1410,7 +1410,9 @@ static void pcnet_csr_writew(PCNetState *s, uint32_t rap, uint32_t new_value)
         break;
     case 76: /* RCVRL */
     case 78: /* XMTRL */
-        val = (val > 0) ? val : 512;
+        /* Ring lengths are exposed as 16-bit two's-complement values. */
+        val = (uint16_t)-val;
+        val = val ? val : 512;
         break;
     case 112:
         if (CSR_STOP(s) || CSR_SPND(s)) {
@@ -1457,6 +1459,10 @@ static uint32_t pcnet_csr_readw(PCNetState *s, uint32_t rap)
         return pcnet_csr_readw(s,2);
     case 58:
         return pcnet_bcr_readw(s,BCR_SWS);
+    case 76: /* RCVRL */
+    case 78: /* XMTRL */
+        val = (uint16_t)-s->csr[rap];
+        break;
     case 88:
         val = s->csr[89];
         val <<= 16;
diff --git a/tests/qtest/pcnet-test.c b/tests/qtest/pcnet-test.c
index 900944f..cdf155b 100644
--- a/tests/qtest/pcnet-test.c
+++ b/tests/qtest/pcnet-test.c
@@ -12,6 +12,11 @@
 #include "qemu/module.h"
 #include "libqos/qgraph.h"
 #include "libqos/pci.h"
+#include "libqos/libqos-malloc.h"
+#include "libqtest-single.h"
+#include "qemu/bswap.h"
+#include "qemu/iov.h"
+#include "qemu/sockets.h"
 
 typedef struct QPCNet QPCNet;
 
@@ -43,16 +48,274 @@ static void *pcnet_create(void *pci_bus, QGuestAllocator *alloc, void *addr)
     return &pcnet->obj;
 }
 
-static void pcnet_register_nodes(void)
+static void pcnet_csr_write(QPCIDevice *dev, QPCIBar io,
+                            uint16_t reg, uint16_t value)
+{
+    qpci_io_writew(dev, io, 0x12, reg);
+    qpci_io_writew(dev, io, 0x10, value);
+}
+
+static uint16_t pcnet_csr_read(QPCIDevice *dev, QPCIBar io, uint16_t reg)
 {
-    QOSGraphEdgeOptions opts = {
-        .extra_device_opts = "addr=04.0",
+    qpci_io_writew(dev, io, 0x12, reg);
+    return qpci_io_readw(dev, io, 0x10);
+}
+
+static void pcnet_ring_lengths(void *obj, void *data, QGuestAllocator *alloc)
+{
+    QPCNet *pcnet = obj;
+    QPCIDevice *dev = &pcnet->dev;
+    QPCIBar io;
+    const uint16_t lengths[] = { 1, 3, 16, 32, 512, 32768, 65535 };
+    const unsigned exponents[] = { 0, 1, 4, 5, 7, 9 };
+    unsigned i, reg, style;
+    uint64_t init_addr = guest_alloc(alloc, 32);
+    uint8_t init[32];
+
+    qpci_device_enable(dev);
+    io = qpci_iomap(dev, 0, NULL);
+    for (style = 0; style <= 2; style += 2) {
+        for (i = 0; i < G_N_ELEMENTS(exponents); i++) {
+            unsigned exponent = exponents[i];
+            uint16_t encoded = -(1U << exponent);
+
+            if (style == 0 && exponent > 7) {
+                continue;
+            }
+            pcnet_csr_write(dev, io, 0, 4);
+            qpci_io_writew(dev, io, 0x12, 20);
+            qpci_io_writew(dev, io, 0x16, style);
+            memset(init, 0, sizeof(init));
+            if (style == 0) {
+                stw_le_p(init + 18, exponent << 13);
+                stw_le_p(init + 22, exponent << 13);
+            } else {
+                init[2] = init[3] = exponent << 4;
+            }
+            qtest_memwrite(global_qtest, init_addr, init, sizeof(init));
+            pcnet_csr_write(dev, io, 1, init_addr);
+            pcnet_csr_write(dev, io, 2, init_addr >> 16);
+            pcnet_csr_write(dev, io, 0, 1);
+            pcnet_csr_write(dev, io, 5, 1); /* Legal SPND read state. */
+            g_assert_cmphex(pcnet_csr_read(dev, io, 76), ==, encoded);
+            g_assert_cmphex(pcnet_csr_read(dev, io, 78), ==, encoded);
+            pcnet_csr_write(dev, io, 5, 0);
+        }
+    }
+    pcnet_csr_write(dev, io, 0, 4);
+    for (reg = 76; reg <= 78; reg += 2) {
+        for (i = 0; i < G_N_ELEMENTS(lengths); i++) {
+            uint16_t encoded = -lengths[i];
+
+            pcnet_csr_write(dev, io, reg, encoded);
+            g_assert_cmphex(pcnet_csr_read(dev, io, reg), ==, encoded);
+        }
+    }
+}
+
+static void pcnet_tx_ring(void *obj, void *data, QGuestAllocator *alloc)
+{
+    QPCNet *pcnet = obj;
+    QPCIDevice *dev = &pcnet->dev;
+    QTestState *qts = global_qtest;
+    QPCIBar io;
+    uint64_t init_addr = guest_alloc(alloc, 32);
+    uint64_t tx_addr = guest_alloc(alloc, 32);
+    uint64_t buffer_addr = guest_alloc(alloc, 64);
+    uint8_t init[32] = { 0 }, tmd[16] = { 0 }, packet[64] = { 0 };
+    unsigned i;
+
+    qpci_device_enable(dev);
+    io = qpci_iomap(dev, 0, NULL);
+    qpci_io_writew(dev, io, 0x12, 20);
+    qpci_io_writew(dev, io, 0x16, 2);
+    init[0] = 1; /* Disable reception. */
+    init[3] = 0x10; /* Two transmit descriptors. */
+    stl_le_p(init + 24, tx_addr);
+    qtest_memwrite(qts, init_addr, init, sizeof(init));
+    qtest_memwrite(qts, buffer_addr, packet, sizeof(packet));
+    stl_le_p(tmd, buffer_addr);
+    stw_le_p(tmd + 4, 0xffc0);
+    stw_le_p(tmd + 6, 0x8300); /* OWN, STP, ENP */
+    for (i = 0; i < 2; i++) {
+        qtest_memwrite(qts, tx_addr + i * 16, tmd, sizeof(tmd));
+    }
+    pcnet_csr_write(dev, io, 1, init_addr);
+    pcnet_csr_write(dev, io, 2, init_addr >> 16);
+    pcnet_csr_write(dev, io, 0, 1);
+    pcnet_csr_write(dev, io, 5, 1);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 78), ==, 0xfffe);
+    pcnet_csr_write(dev, io, 78, 0xfffe);
+    pcnet_csr_write(dev, io, 5, 0);
+    pcnet_csr_write(dev, io, 0, 0x102);
+    pcnet_csr_write(dev, io, 0, 8);
+    for (i = 0; i < 2; i++) {
+        g_assert_cmphex(qtest_readw(qts, tx_addr + i * 16 + 6) & 0x8000,
+                        ==, 0);
+    }
+    g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x200, ==, 0x200);
+    /* Recycle descriptor zero to check wrap after both entries. */
+    qtest_memwrite(qts, tx_addr, tmd, sizeof(tmd));
+    pcnet_csr_write(dev, io, 0, 0x208);
+    g_assert_cmphex(qtest_readw(qts, tx_addr + 6) & 0x8000, ==, 0);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x200, ==, 0x200);
+}
+
+#ifndef _WIN32
+typedef struct PCNetRxContext {
+    int sockets[2];
+    char *dump_path;
+    off_t dump_size;
+} PCNetRxContext;
+
+static void pcnet_rx_cleanup(void *opaque)
+{
+    PCNetRxContext *ctx = opaque;
+
+    close(ctx->sockets[0]);
+    close(ctx->sockets[1]);
+    unlink(ctx->dump_path);
+    g_free(ctx->dump_path);
+    g_free(ctx);
+    qos_invalidate_command_line();
+}
+
+static void *pcnet_rx_setup(GString *cmd_line, void *arg)
+{
+    PCNetRxContext *ctx = g_new0(PCNetRxContext, 1);
+    int fd = g_file_open_tmp("pcnet-rx-XXXXXX", &ctx->dump_path, NULL);
+
+    ctx->dump_size = 24;
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    g_assert_cmpint(socketpair(PF_UNIX, SOCK_STREAM, 0, ctx->sockets), ==, 0);
+    g_string_append_printf(cmd_line,
+                           " -netdev socket,fd=%d,id=pcnet-test-net"
+                           " -object filter-dump,id=pcnet-test-dump,"
+                           "netdev=pcnet-test-net,file=%s",
+                           ctx->sockets[1], ctx->dump_path);
+    g_test_queue_destroy(pcnet_rx_cleanup, ctx);
+    return ctx;
+}
+
+static void pcnet_send_frame(PCNetRxContext *ctx, const uint8_t *packet,
+                             size_t length)
+{
+    uint32_t packet_len = htonl(length);
+    struct iovec iov[] = {
+        { .iov_base = &packet_len, .iov_len = sizeof(packet_len) },
+        { .iov_base = (void *)packet, .iov_len = length },
     };
-    add_qpci_address(&opts, &(QPCIAddress) { .devfn = QPCI_DEVFN(4, 0) });
+    struct stat st;
+    int64_t deadline = g_get_monotonic_time() + 5 * G_USEC_PER_SEC;
+
+    g_assert_cmpint(iov_send(ctx->sockets[0], iov, 2, 0,
+                            sizeof(packet_len) + length), ==,
+                    sizeof(packet_len) + length);
+    ctx->dump_size += 16 + length;
+    do {
+        qtest_clock_step(global_qtest, 1000000);
+        g_assert_cmpint(stat(ctx->dump_path, &st), ==, 0);
+        if (st.st_size >= ctx->dump_size) {
+            return;
+        }
+        g_usleep(1000);
+    } while (g_get_monotonic_time() < deadline);
+    g_assert_not_reached();
+}
+
+static void pcnet_rx_startup(void *obj, void *data, QGuestAllocator *alloc)
+{
+    QPCNet *pcnet = obj;
+    QPCIDevice *dev = &pcnet->dev;
+    PCNetRxContext *ctx = data;
+    QTestState *qts = global_qtest;
+    QPCIBar io;
+    unsigned count = 2;
+    uint64_t init_addr = guest_alloc(alloc, 32);
+    uint64_t rx_addr = guest_alloc(alloc, count * 16);
+    uint64_t tx_addr = guest_alloc(alloc, count * 16);
+    uint64_t buffer_addr = guest_alloc(alloc, count * 2048);
+    uint8_t init[32] = { 0 }, rmd[16] = { 0 }, buffer[64];
+    uint8_t packet[64] = {
+        0x52, 0x54, 0x00, 0x12, 0x34, 0x56,
+        0x52, 0x54, 0x00, 0xab, 0xcd, 0xef, 0x88, 0xb5,
+    };
+    unsigned i;
+
+    qpci_device_enable(dev);
+    io = qpci_iomap(dev, 0, NULL);
+    qpci_io_writew(dev, io, 0x12, 20);
+    qpci_io_writew(dev, io, 0x16, 2);
+    init[2] = init[3] = count == 2 ? 0x10 : 0;
+    memcpy(init + 4, packet, 6);
+    stl_le_p(init + 20, rx_addr);
+    stl_le_p(init + 24, tx_addr);
+    stw_le_p(rmd + 4, 0xf800);
+    stw_le_p(rmd + 6, 0x8000);
+    for (i = 0; i < count; i++) {
+        stl_le_p(rmd, buffer_addr + i * 2048);
+        qtest_memwrite(qts, rx_addr + i * 16, rmd, sizeof(rmd));
+    }
+    qtest_memwrite(qts, init_addr, init, sizeof(init));
+    qtest_memset(qts, tx_addr, 0, count * 16);
+    pcnet_csr_write(dev, io, 1, init_addr);
+    pcnet_csr_write(dev, io, 2, init_addr >> 16);
+    pcnet_csr_write(dev, io, 0, 1);
 
+
+    /* Program valid ring lengths while suspended, then exercise wrap. */
+    pcnet_csr_write(dev, io, 5, 1);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 76), ==, 0xfffe);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 78), ==, 0xfffe);
+    pcnet_csr_write(dev, io, 76, 0xfffe);
+    pcnet_csr_write(dev, io, 78, 0xfffe);
+    pcnet_csr_write(dev, io, 5, 0);
+
+
+    pcnet_csr_write(dev, io, 0, 0x142);
+    /* Starting must not resurrect the rejected pre-start frame. */
+    g_assert_cmphex(qtest_readw(qts, rx_addr + 6) & 0x8000, ==, 0x8000);
+    g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x400, ==, 0);
+    for (i = 0; i < count + 1; i++) {
+        unsigned entry = i % count;
+
+        packet[63] = i + 1;
+        pcnet_send_frame(ctx, packet, sizeof(packet));
+        g_assert_cmphex(qtest_readw(qts, rx_addr + entry * 16 + 6) & 0x8000,
+                        ==, 0);
+        g_assert_cmphex(pcnet_csr_read(dev, io, 0) & 0x400, ==, 0x400);
+        qtest_memread(qts, buffer_addr + entry * 2048, buffer, sizeof(buffer));
+        g_assert_cmpmem(buffer, sizeof(buffer), packet, sizeof(packet));
+        qtest_writew(qts, rx_addr + entry * 16 + 6, 0x8000);
+        pcnet_csr_write(dev, io, 0, 0x440);
+    }
+}
+
+#endif
+
+static void pcnet_register_nodes(void)
+{
+    QOSGraphEdgeOptions opts = { .extra_device_opts = "addr=04.0" };
+
+    add_qpci_address(&opts, &(QPCIAddress) { .devfn = QPCI_DEVFN(4, 0) });
     qos_node_create_driver("pcnet", pcnet_create);
     qos_node_consumes("pcnet", "pci-bus", &opts);
     qos_node_produces("pcnet", "pci-device");
+    qos_add_test("ring-length-encoding", "pcnet", pcnet_ring_lengths, NULL);
+    qos_add_test("tx-manual-ring-wrap", "pcnet", pcnet_tx_ring, NULL);
+#ifndef _WIN32
+    {
+        QOSGraphTestOptions test_opts = {
+            .before = pcnet_rx_setup,
+            .edge.extra_device_opts = "netdev=pcnet-test-net",
+        };
+
+        qos_add_test("rx-manual-ring-wrap", "pcnet", pcnet_rx_startup,
+                     &test_opts);
+    }
+#endif
 }
 
 libqos_init(pcnet_register_nodes);
