+static void artist_fractional_write(ARTISTState *s, struct vram_buffer *buf,
+                                    hwaddr addr, uint32_t data, unsigned size)
+{
+    unsigned x = (addr >> 2) & 2047, y = addr >> 13;
+    uint32_t rgb = 0;
+    unsigned i, shift;
+    uint8_t mask = 0;
+    static const uint8_t channel_mask[] = {0, 0xe0, 0x1c, 3};
+
+    if (x >= buf->width || y >= buf->height) {
+        return;
+    }
+    if ((s->image_bitmap_op & 0x20000000) &&
+        !(s->vram_bitmask & 0x80000000U)) {
+        return;
+    }
+    /*
+     * Subword writes affect only their RGB channels. The high byte is padding,
+     * not another pixel. MMIO accesses are naturally aligned by the core.
+     */
+    for (i = 0; i < size; i++) {
+        unsigned channel = (addr + i) & 3;
+        shift = (3 - channel) * 8;
+        rgb |= ((data >> ((size - i - 1) * 8)) & 255) << shift;
+        mask |= channel_mask[channel];
+    }
+    artist_rop8_mask(s, buf, y * buf->width + x,
+                    artist_encode_rgb(rgb, x, y, s->image_bitmap_op & 0x40),
+                    mask);
+    memory_region_set_dirty(&buf->mr, y * buf->width + x, 1);
+}
