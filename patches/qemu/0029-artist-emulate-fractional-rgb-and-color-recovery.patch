+/*
+ * Artist's fractional RGB aperture stores one 3:3:2 pixel per byte.
+ * Dither matrices: HP Graphics Administration Guide, HP-UX 10.20, pp. 52-54.
+ * Unlike the HCRX matrices, these are specific to the integrated Artist.
+ */
+static const int8_t artist_dither[3][2][16] = {
+    {
+        {-16, 4, -1, 11, -14, 6, -3, 9, -15, 5, -2, 10, -13, 7, -4, 8},
+        {15, -5, 0, -12, 13, -7, 2, -10, 14, -6, 1, -11, 12, -8, 3, -9}
+    }, {
+        {11, -15, 7, -3, 8, -14, 4, -2, 10, -16, 6, -4, 9, -13, 5, -1},
+        {-12, 14, -8, 2, -9, 13, -5, 1, -11, 15, -7, 3, -10, 12, -6, 0}
+    }, {
+        {-3, 9, -13, 7, -1, 11, -15, 5, -4, 8, -14, 6, -2, 10, -16, 4},
+        {2, -10, 12, -8, 0, -12, 14, -6, 3, -9, 13, -7, 1, -11, 15, -5}
+    }
+};
+
+static bool artist_fractional(uint32_t access)
+{
+    return (access >> 16) == 0xbba0;
+}
+
+static uint8_t artist_encode_rgb(uint32_t rgb, unsigned x, unsigned y,
+                                 bool dither)
+{
+    int r = (rgb >> 16) & 255, g = (rgb >> 8) & 255, b = rgb & 255;
+
+    if (!dither) {
+        return (r & 0xe0) | ((g & 0xe0) >> 3) | (b >> 6);
+    }
+    r = MIN(255, MAX(0, r + artist_dither[0][y & 1][x & 15]));
+    g = MIN(255, MAX(0, g + artist_dither[1][y & 1][x & 15]));
+    b = MIN(255, MAX(0, b + 2 * artist_dither[2][y & 1][x & 15]));
+    return (r & 0xe0) | ((g & 0xe0) >> 3) | (b >> 6);
+}
+
+static uint32_t artist_decode_rgb(uint8_t pixel)
+{
+    unsigned r = pixel >> 5, g = (pixel >> 2) & 7, b = pixel & 3;
+
+    return ((r * 255 / 7) << 16) | ((g * 255 / 7) << 8) | (b * 85);
+}
+
+static uint8_t artist_drawing_color(ARTISTState *s, uint32_t color,
+                                    unsigned x, unsigned y)
+{
+    return artist_fractional(s->dst_bm_access) ?
+           artist_encode_rgb(color, x, y, s->image_bitmap_op & 0x40) : color;
+}
