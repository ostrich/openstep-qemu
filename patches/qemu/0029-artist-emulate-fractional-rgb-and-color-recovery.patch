+static void fractional_access(void)
+{
+    QTestState *q = start();
+
+    qtest_writel(q, DBA, 0xbba00000);
+    qtest_writel(q, IBO, 0x03000340);
+    qtest_writel(q, FB, 0x008090a0);
+    qtest_writel(q, FB + 4, 0x008090a0);
+    qtest_writel(q, FB + 8192, 0x008090a0);
+    /* Independently calculated Artist matrix positions (0,0), (1,0), (0,1). */
+    g_assert_cmphex(qtest_readb(q, FB), ==, 0x72);
+    g_assert_cmphex(qtest_readb(q, FB + 1), ==, 0x92);
+    g_assert_cmphex(qtest_readb(q, FB + 2048), ==, 0x92);
+    qtest_writel(q, FB + 8, 0x00ffffff);
+    qtest_writel(q, FB + 12, 0);
+    g_assert_cmphex(qtest_readb(q, FB + 2), ==, 0xff);
+    g_assert_cmphex(qtest_readb(q, FB + 3), ==, 0);
+    qtest_writel(q, SBA, 0xbba00000);
+    g_assert_cmphex(qtest_readl(q, FB + 8), ==, 0xffffff);
+    g_assert_cmphex(qtest_readl(q, FB + 12), ==, 0);
+    g_assert_cmphex(qtest_readl(q, FB + 1280 * 4), ==, 0);
+    qtest_quit(q);
+}
+
+static void fractional_readback(void)
+{
+    QTestState *q = start();
+    unsigned i;
+
+    /* Save/restore disables dithering (IBO bit 6) in the native HP driver. */
+    for (i = 0; i < 256; i++) {
+        uint32_t rgb;
+        qtest_writel(q, DBA, 0x13600000);
+        qtest_writeb(q, FB + i, i);
+        qtest_writel(q, SBA, 0xbba00000);
+        rgb = qtest_readl(q, FB + i * 4);
+        qtest_writel(q, DBA, 0xbba00000);
+        qtest_writel(q, FB + 8192 + i * 4, rgb);
+        qtest_writel(q, SBA, 0x13600000);
+        g_assert_cmphex(qtest_readb(q, FB + 2048 + i), ==, i);
+    }
+    qtest_writel(q, DBA, 0xbba00000);
+    qtest_writel(q, FB, 0x123456);
+    qtest_writeb(q, FB + 1, 0xff); /* red only */
+    g_assert_cmphex(qtest_readb(q, FB) & 0xe0, ==, 0xe0);
+    g_assert_cmphex(qtest_readb(q, FB) & 0x1f, ==, 5);
+    qtest_writew(q, FB + 2, 0xffff); /* green and blue */
+    g_assert_cmphex(qtest_readb(q, FB), ==, 0xff);
+    qtest_writeb(q, FB, 0); /* padding is ignored */
+    g_assert_cmphex(qtest_readb(q, FB), ==, 0xff);
+    qtest_quit(q);
+}
+
+static void fractional_fill(void)
+{
+    QTestState *q = start();
+    unsigned x, y;
+
+    qtest_writel(q, DBA, 0xbba00000);
+    qtest_writel(q, IBO, 0x83000360);
+    qtest_writel(q, REG + 0x118014, 0x00ff0000);
+    qtest_writel(q, REG + 0x100800, (5 << 16) | 7);
+    qtest_writel(q, REG + 0x100a04, (20 << 16) | 2);
+    for (y = 7; y < 9; y++) {
+        for (x = 5; x < 25; x++) {
+            g_assert_cmphex(qtest_readb(q, FB + y * 2048 + x), ==, 0xe0);
+        }
+    }
+    g_assert_cmphex(qtest_readb(q, FB + 7 * 2048 + 4), ==, 0);
+    g_assert_cmphex(qtest_readb(q, FB + 9 * 2048 + 5), ==, 0);
+    qtest_quit(q);
+}
+
+static void fractional_drawing(void)
+{
+    QTestState *q = start();
+
+    qtest_writel(q, DBA, 0xbba00000);
+    qtest_writel(q, IBO, 0x03000342);
+    qtest_writel(q, REG + 0x118010, 0x8090a0);
+    qtest_writel(q, REG + 0x100800, 0);
+    qtest_writel(q, REG + 0x100e44, 1 << 16);
+    g_assert_cmphex(qtest_readb(q, FB), ==, 0x72);
+    g_assert_cmphex(qtest_readb(q, FB + 1), ==, 0x92);
+    qtest_writel(q, REG + 0x100800, (10 << 16) | 2);
+    qtest_writel(q, REG + 0x100804, (16 << 16) | 2);
+    qtest_writel(q, REG + 0x100aa0, 0xffff0000);
+    g_assert_cmphex(qtest_readb(q, FB + 2 * 2048 + 10), ==, 0x72);
+    g_assert_cmphex(qtest_readb(q, FB + 2 * 2048 + 11), ==, 0x92);
+    qtest_writel(q, IBO, 0x23000340);
+    qtest_writel(q, MASK, 0);
+    qtest_writel(q, FB + 8192, 0xffffff);
+    g_assert_cmphex(qtest_readb(q, FB + 2048), ==, 0);
+    qtest_writel(q, MASK, 0x80000000);
+    qtest_writel(q, FB + 8192, 0xffffff);
+    g_assert_cmphex(qtest_readb(q, FB + 2048), ==, 0xff);
+    qtest_quit(q);
+}
+
+static void source_trigger_blit(void)
+{
+    QTestState *q = start();
+    uint8_t original[8][128], expected[8][128], actual[128];
+    unsigned x, y;
+
+    for (y = 0; y < 8; y++) {
+        for (x = 0; x < 128; x++) {
+            original[y][x] = y * 37 + x;
+        }
+        qtest_memwrite(q, FB + y * 2048, original[y], 128);
+    }
+    memcpy(expected, original, sizeof(expected));
+    for (y = 0; y < 4; y++) {
+        memcpy(expected[y + 2] + 40, original[y] + 20, 60);
+    }
+    /* NGLE permits the blit opcode on the source, size or destination write. */
+    qtest_writel(q, REG + 0x100800, (40 << 16) | 2);
+    qtest_writel(q, REG + 0x100804, (60 << 16) | 4);
+    qtest_writel(q, REG + 0x100b08, 20 << 16);
+    for (y = 0; y < 8; y++) {
+        qtest_memread(q, FB + y * 2048, actual, 128);
+        g_assert_cmpmem(actual, 128, expected[y], 128);
+    }
+    qtest_quit(q);
+}
+
+static uint32_t screen_pixel(QTestState *q, unsigned x, unsigned y)
+{
+    g_autofree char *name = NULL;
+    unsigned width, height, max;
+    uint8_t pixel[3];
+    FILE *image;
+    int fd = g_file_open_tmp("qtest-artist-XXXXXX", &name, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    qtest_qmp_assert_success(q, "{'execute':'screendump',"
+                            "'arguments':{'filename':%s}}", name);
+    image = fopen(name, "rb");
+    g_assert_nonnull(image);
+    g_assert_cmpint(fscanf(image, "P6 %u %u %u", &width, &height, &max), ==, 3);
+    g_assert_cmpuint(max, ==, 255);
+    g_assert_cmpuint(x, <, width);
+    g_assert_cmpuint(y, <, height);
+    g_assert_cmpint(fgetc(image), ==, '\n');
+    g_assert_cmpint(fseek(image, (y * width + x) * 3, SEEK_CUR), ==, 0);
+    g_assert_cmpuint(fread(pixel, 1, 3, image), ==, 3);
+    fclose(image);
+    unlink(name);
+    return (pixel[0] << 16) | (pixel[1] << 8) | pixel[2];
+}
+
+static void palette(QTestState *q, unsigned index, uint32_t rgb)
+{
+    qtest_writel(q, DBA, 0xbbe0f000);
+    qtest_writel(q, REG + 0x1004a0, (0x100 + index) * 4);
+    qtest_writel(q, REG + 0x100600, rgb);
+    qtest_writel(q, DBA, 0x13600000);
+}
+
+static void component_lut(QTestState *q)
+{
+    unsigned i;
+    for (i = 0; i < 256; i++) {
+        palette(q, i, i * 0x010101);
+    }
+}
+
+static void recovery_scanout(void)
+{
+    QTestState *q = start();
+    unsigned x, y;
+
+    palette(q, 0x60, 0x600000);
+    palette(q, 0x80, 0x800000);
+    palette(q, 0xe0, 0xff0000);
+    for (y = 10; y <= 12; y++) {
+        for (x = 0; x < 32; x++) {
+            qtest_writeb(q, FB + y * 2048 + x, 0x60);
+        }
+    }
+    qtest_writeb(q, FB + 11 * 2048 + 16, 0x80);
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0x800000);
+    component_lut(q);
+    qtest_writel(q, REG + 0x300308, 0x00800003);
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0x6e0000);
+    /* A changed preceding row must dirty the filtered output row too. */
+    qtest_writeb(q, FB + 10 * 2048 + 16, 0x80);
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0x700000);
+    /* A high-contrast isolated feature must survive edge rejection. */
+    qtest_writeb(q, FB + 11 * 2048 + 16, 0xe0);
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0xff0000);
+    qtest_writel(q, REG + 0x300308, 0x00800000);
+    palette(q, 0xe0, 0x112233);
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0x112233);
+    qtest_quit(q);
+}
+
+static void wait_migration(QTestState *q)
+{
+    int64_t deadline = g_get_monotonic_time() + 30 * G_TIME_SPAN_SECOND;
+
+    while (true) {
+        QDict *r = qtest_qmp_assert_success_ref(q,
+                                               "{'execute':'query-migrate'}");
+        const char *status = qdict_get_str(r, "status");
+        bool done = !strcmp(status, "completed");
+
+        g_assert_cmpstr(status, !=, "failed");
+        qobject_unref(r);
+        if (done) {
+            return;
+        }
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        g_usleep(1000);
+    }
+}
+
+static void recovery_migration(void)
+{
+    QTestState *from = start(), *to;
+    g_autofree char *path = NULL;
+    g_autofree char *uri = NULL;
+    int fd = g_file_open_tmp("qtest-artist-migration-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    uri = g_strdup_printf("file:%s", path);
+    component_lut(from);
+    qtest_writeb(from, FB + 11 * 2048 + 16, 0xe0);
+    qtest_writel(from, REG + 0x300308, 0x00800003);
+    g_assert_cmphex(screen_pixel(from, 16, 11), ==, 0xff0000);
+    qtest_qmp_assert_success(from,
+        "{'execute':'migrate','arguments':{'uri':%s}}", uri);
+    wait_migration(from);
+    to = qtest_init("-machine 715 -m 64 -nic none -incoming defer");
+    qtest_qmp_assert_success(to,
+        "{'execute':'migrate-incoming','arguments':{'uri':%s}}", uri);
+    wait_migration(to);
+    g_assert_cmphex(qtest_readb(to, FB + 11 * 2048 + 16), ==, 0xe0);
+    g_assert_cmphex(screen_pixel(to, 16, 11), ==, 0xff0000);
+    qtest_quit(to);
+    qtest_quit(from);
+    unlink(path);
+}
+
+static void recovery_reset(void)
+{
+    QTestState *q = start();
+
+    palette(q, 0x60, 0x600000);
+    palette(q, 0x80, 0x800000);
+    qtest_writeb(q, FB + 11 * 2048 + 16, 0x80);
+    qtest_writeb(q, FB + 11 * 2048 + 15, 0x60);
+    component_lut(q);
+    qtest_writel(q, REG + 0x300308, 0x00800003);
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0x910000);
+    qtest_qmp_assert_success(q, "{'execute':'system_reset'}");
+    g_assert_cmphex(screen_pixel(q, 16, 11), ==, 0x808080);
+    qtest_quit(q);
+}
