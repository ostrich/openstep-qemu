+/*
+ * HP Journal, April 1995, pp. 55-57: a 2x16 edge-preserving filter.
+ * Neighbors outside +/-1 of the center component contribute the center,
+ * so the divisor stays 32 rather than depending on an adaptive sample count.
+ * Use the preceding row and a centered horizontal footprint.
+ */
+static void artist_recover_accumulate(int count[3][8], uint8_t pixel, int delta)
+{
+    count[0][pixel >> 5] += delta;
+    count[1][(pixel >> 2) & 7] += delta;
+    count[2][pixel & 3] += delta;
+}
+
+static void artist_recover_line(ARTISTState *s, uint32_t *dest,
+                                const uint8_t *src)
+{
+    const uint8_t *fb = s->vram_buffer[ARTIST_BUFFER_AP].data;
+    const uint32_t *cmap = (const uint32_t *)
+        (s->vram_buffer[ARTIST_BUFFER_CMAP].data + 0x400);
+    unsigned y = (src - fb) / s->width;
+    unsigned rows[2] = {MAX(0, (int)y - 1), y};
+    int count[3][8] = { { 0 } };
+    unsigned x, c, row;
+    int dx;
+    static const unsigned shifts[] = {5, 2, 0};
+    static const unsigned masks[] = {7, 7, 3};
+
+    /* Sliding component histograms avoid re-reading all 32 taps per pixel. */
+    for (row = 0; row < 2; row++) {
+        for (dx = -7; dx <= 8; dx++) {
+            artist_recover_accumulate(count,
+                                      fb[rows[row] * s->width + MAX(0, dx)], 1);
+        }
+    }
+    for (x = 0; x < s->width; x++) {
+        unsigned out = 0;
+        uint8_t center = src[x];
+
+        for (c = 0; c < 3; c++) {
+            int cv = (center >> shifts[c]) & masks[c];
+            int v, total = 32 * cv;
+            unsigned index, shift = 16 - c * 8;
+
+            for (v = MAX(0, cv - 1); v <= MIN(masks[c], cv + 1); v++) {
+                total += count[c][v] * (v - cv);
+            }
+            /*
+             * Recovery precedes the DAC's independent component LUTs.
+             * An RGB ramp is not an indexed 3:3:2 palette.
+             */
+            index = (total * 255 + 16 * masks[c]) / (32 * masks[c]);
+            out |= cmap[index] & (255U << shift);
+        }
+        dest[x] = out;
+        for (row = 0; row < 2; row++) {
+            artist_recover_accumulate(count,
+                fb[rows[row] * s->width + MAX(0, (int)x - 7)], -1);
+            artist_recover_accumulate(count,
+                fb[rows[row] * s->width + MIN(s->width - 1, x + 9)], 1);
+        }
+    }
+}
