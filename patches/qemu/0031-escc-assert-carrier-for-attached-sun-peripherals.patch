Subject: [PATCH 31/31] escc: assert carrier for attached Sun input devices

Sun keyboard and mouse channels have an emulated peripheral permanently
attached. Report carrier in RR0 after channel and device reset, while leaving
RS232 channels unchanged. OPENSTEP 4.2 otherwise sleeps in zsopen while
opening the mouse during console initialization, before starting Workspace.

Use the existing migrated status register without adding migration fields.
Test power-on, WR9 channel/hard resets, system reset and migration, including
negative controls for ordinary serial channels.

diff --git a/hw/char/escc.c b/hw/char/escc.c
index 7aae627..b39e1fe 100644
--- a/hw/char/escc.c
+++ b/hw/char/escc.c
@@ -290,6 +290,11 @@ static void escc_reset_chn(ESCCChannelState *s)
     s->e0_mode = s->led_mode = s->caps_lock_mode = s->num_lock_mode = 0;
     s->sunmouse_dx = s->sunmouse_dy = s->sunmouse_buttons = 0;
     clear_queue(s);
+
+    /* The emulated Sun keyboard and mouse are permanently attached. */
+    if (s->type == escc_kbd || s->type == escc_mouse) {
+        s->rregs[R_STATUS] |= STATUS_DCD;
+    }
 }
 
 static void escc_soft_reset_chn(ESCCChannelState *s)
diff --git a/tests/qtest/escc-test.c b/tests/qtest/escc-test.c
new file mode 100644
index 0000000..1854117
--- /dev/null
+++ b/tests/qtest/escc-test.c
@@ -0,0 +1,110 @@
+/* Sun ESCC peripheral inputs. SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define SERIAL 0x71100000
+#define PERIPHERAL 0x71000000
+#define DCD 0x08
+
+static QTestState *start(bool incoming)
+{
+    return qtest_initf("-machine SS-5 -m 64 -display none -nic none "
+                       "-serial none %s", incoming ? "-incoming defer" : "");
+}
+
+static void carrier(QTestState *q)
+{
+    for (unsigned offset = 0; offset <= 4; offset += 4) {
+        /* A reset of the other channel can leave RR9 selected here. */
+        qtest_readb(q, PERIPHERAL + offset);
+        qtest_readb(q, SERIAL + offset);
+        g_assert_cmphex(qtest_readb(q, PERIPHERAL + offset) & DCD, ==, DCD);
+        g_assert_cmphex(qtest_readb(q, SERIAL + offset) & DCD, ==, 0);
+    }
+}
+
+static void status(void)
+{
+    QTestState *q = start(false);
+
+    carrier(q);
+    qtest_quit(q);
+}
+
+static void channel_reset(void)
+{
+    QTestState *q = start(false);
+
+    for (unsigned command = 0x40; command <= 0xc0; command += 0x40) {
+        qtest_writeb(q, PERIPHERAL + 4, 9);
+        qtest_writeb(q, PERIPHERAL + 4, command);
+        carrier(q);
+        qtest_writeb(q, SERIAL + 4, 9);
+        qtest_writeb(q, SERIAL + 4, command);
+        carrier(q);
+    }
+    qtest_quit(q);
+}
+
+static void system_reset(void)
+{
+    QTestState *q = start(false);
+
+    qtest_qmp_assert_success(q, "{'execute':'system_reset'}");
+    carrier(q);
+    qtest_quit(q);
+}
+
+static void migration_wait(QTestState *q)
+{
+    int64_t deadline = g_get_monotonic_time() + 10 * G_TIME_SPAN_SECOND;
+
+    while (true) {
+        QDict *reply = qtest_qmp_assert_success_ref(
+            q, "{'execute':'query-migrate'}");
+        const char *state = qdict_get_str(reply, "status");
+        bool done = !strcmp(state, "completed");
+
+        g_assert_cmpstr(state, !=, "failed");
+        qobject_unref(reply);
+        if (done) {
+            return;
+        }
+        g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+        g_usleep(1000);
+    }
+}
+
+static void migration(void)
+{
+    QTestState *from = start(false), *to;
+    g_autofree char *path = NULL;
+    int fd = g_file_open_tmp("escc-carrier-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    g_autofree char *uri = g_strdup_printf("file:%s", path);
+    carrier(from);
+    qtest_qmp_assert_success(from,
+        "{'execute':'migrate','arguments':{'uri':%s}}", uri);
+    migration_wait(from);
+    qtest_quit(from);
+    to = start(true);
+    qtest_qmp_assert_success(to,
+        "{'execute':'migrate-incoming','arguments':{'uri':%s}}", uri);
+    migration_wait(to);
+    carrier(to);
+    qtest_quit(to);
+    unlink(path);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/escc/sun/carrier", status);
+    qtest_add_func("/escc/sun/channel-reset", channel_reset);
+    qtest_add_func("/escc/sun/system-reset", system_reset);
+    qtest_add_func("/escc/sun/migration", migration);
+    return g_test_run();
+}
